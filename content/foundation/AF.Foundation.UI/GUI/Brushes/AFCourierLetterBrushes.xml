<Brushes>
  <Brush Name="AF.ApiOnboarding.Option.Button">
    <Layers>
      <BrushLayer Name="Border" Sprite="BlankWhiteSquare_9" Color="#796B55FF" />
      <BrushLayer Name="Fill" Sprite="BlankWhiteSquare_9" Color="#242423FF" ExtendLeft="-1" ExtendRight="-1" ExtendTop="-1" ExtendBottom="-1" />
    </Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Border" ColorFactor="1" /><BrushLayer Name="Fill" ColorFactor="1" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Border" Color="#D0B98FFF" /><BrushLayer Name="Fill" Color="#383A38FF" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Border" Color="#E7D6B4FF" /><BrushLayer Name="Fill" Color="#171918FF" /></Style>
      <Style Name="Disabled"><BrushLayer Name="Border" AlphaFactor="0.45" /><BrushLayer Name="Fill" AlphaFactor="0.45" /></Style>
    </Styles>
    <SoundProperties><EventSounds><EventSound EventName="Click" Audio="panels/next" /></EventSounds></SoundProperties>
  </Brush>
  <Brush Name="AF.ApiOnboarding.Option.Text" BaseBrush="Info.Text" Font="simkai" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontSize="22" FontColor="#F4ECDDFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" />
      <Style Name="Hovered" FontColor="#FFFFFFFF" />
      <Style Name="Pressed" FontColor="#DDCCAAFF" />
      <Style Name="Disabled" FontColor="#F4ECDD77" />
    </Styles>
  </Brush>
  <Brush Name="AFWorldBulletin.Archive.Button">
    <Layers>
      <BrushLayer Name="Border" Sprite="BlankWhiteSquare_9" Color="#87633CFF" />
      <BrushLayer Name="Fill" Sprite="BlankWhiteSquare_9" Color="#D7BA86FF" ExtendLeft="-1" ExtendRight="-1" ExtendTop="-1" ExtendBottom="-1" />
    </Layers>
    <Styles>
      <Style Name="Default"><BrushLayer Name="Border" ColorFactor="1" /><BrushLayer Name="Fill" ColorFactor="1" /></Style>
      <Style Name="Hovered"><BrushLayer Name="Border" ColorFactor="0.8" /><BrushLayer Name="Fill" ColorFactor="1.12" /></Style>
      <Style Name="Pressed"><BrushLayer Name="Border" ColorFactor="0.7" /><BrushLayer Name="Fill" ColorFactor="0.88" /></Style>
      <Style Name="Disabled"><BrushLayer Name="Border" AlphaFactor="0.5" /><BrushLayer Name="Fill" AlphaFactor="0.5" /></Style>
    </Styles>
  </Brush>

  <Brush Name="AFCourierLetter.Title.Text" BaseBrush="Info.Text" Font="simkai" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontSize="34" FontColor="#15100BFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" TextShadowOffset="0" />
    </Styles>
  </Brush>

  <Brush Name="AFCourierLetter.Meta.Text" BaseBrush="Info.Text" Font="simkai" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Styles>
      <Style Name="Default" FontSize="20" FontColor="#15100BFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" TextShadowOffset="0" />
    </Styles>
  </Brush>

  <Brush Name="AFCourierLetter.Body.Text" BaseBrush="Info.Text" Font="simkai" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Styles>
      <Style Name="Default" FontSize="22" FontColor="#15100BFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" TextShadowOffset="0" />
    </Styles>
  </Brush>

  <Brush Name="AFCourierLetter.Button.Text" BaseBrush="Info.Text" Font="simkai" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontSize="22" FontColor="#15100BFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" TextShadowOffset="0" />
      <Style Name="Hovered" FontColor="#2B2117FF" />
      <Style Name="Pressed" FontColor="#0D0906FF" />
      <Style Name="Disabled" FontColor="#15100B88" />
    </Styles>
  </Brush>

  <!-- Translucent band button for courier letters. The placeholder is a flat dark bar; AnimusForgeCourierUiSprites swaps in
       af_courier_button_band.png (edge-faded band with gold rules) and resets the layer color to white before each popup loads. -->
  <Brush Name="AFCourierLetter.Band.Button">
    <Layers>
      <BrushLayer Name="Default" Sprite="BlankWhiteSquare_9" Color="#0B080680" />
    </Layers>
    <Styles>
      <Style Name="Default">
        <BrushLayer Name="Default" ColorFactor="1" AlphaFactor="1" />
      </Style>
      <Style Name="Hovered">
        <BrushLayer Name="Default" ColorFactor="2.4" AlphaFactor="1.15" />
      </Style>
      <Style Name="Pressed">
        <BrushLayer Name="Default" ColorFactor="0.6" AlphaFactor="1.3" />
      </Style>
      <Style Name="Disabled">
        <BrushLayer Name="Default" ColorFactor="1" AlphaFactor="0.45" />
      </Style>
    </Styles>
    <SoundProperties>
      <EventSounds>
        <EventSound EventName="Click" Audio="panels/next" />
      </EventSounds>
    </SoundProperties>
  </Brush>

  <Brush Name="AFCourierLetter.Band.Button.Text" BaseBrush="Info.Text" Font="simkai" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontSize="22" FontColor="#F4ECDDFF" TextOutlineColor="#000000CC" TextOutlineAmount="0.12" TextGlowRadius="0" TextBlur="0" TextShadowOffset="0" />
      <Style Name="Hovered" FontColor="#FFF7E6FF" />
      <Style Name="Pressed" FontColor="#D9C9ABFF" />
      <Style Name="Disabled" FontColor="#F4ECDD77" />
    </Styles>
  </Brush>

  <!-- Inherit Info.Text's native Link.Hero/Settlement/Kingdom/Clan/Unit styles while retaining the popup's original typography. -->
  <Brush Name="AnimusForge.EntityLink.PopupDescription.Text" BaseBrush="Info.Text" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left">
    <Styles>
      <Style Name="Default" FontColor="#F1E9DAFF" TextGlowColor="#000000FF" TextOutlineColor="#000000FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" FontSize="20" />
    </Styles>
  </Brush>

  <!-- Weekly-report parchment uses a light yellow canvas, so this keeps each native link category distinct while giving it darker readable contrast. -->
  <Brush Name="AnimusForge.EntityLink.WeeklyReport.LinkPalette" BaseBrush="Info.Text">
    <Styles>
      <Style Name="Link" TextColorFactor="1" FontColor="#306F77FF" TextGlowColor="#111111FF" />
      <Style Name="Link.MouseOver" TextColorFactor="1.12" FontColor="#306F77FF" TextGlowColor="#111111FF" />
      <Style Name="Link.MouseDown" TextColorFactor="0.72" FontColor="#306F77FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Settlement" TextColorFactor="1" FontColor="#8D623FFF" TextGlowColor="#111111FF" />
      <Style Name="Link.Settlement.MouseOver" TextColorFactor="1.12" FontColor="#8D623FFF" TextGlowColor="#111111FF" />
      <Style Name="Link.Settlement.MouseDown" TextColorFactor="0.72" FontColor="#8D623FFF" TextGlowColor="#111111FF" />
      <Style Name="Link.Hero" TextColorFactor="1" FontColor="#557F8EFF" TextGlowColor="#111111FF" />
      <Style Name="Link.Hero.MouseOver" TextColorFactor="1.12" FontColor="#557F8EFF" TextGlowColor="#111111FF" />
      <Style Name="Link.Hero.MouseDown" TextColorFactor="0.72" FontColor="#557F8EFF" TextGlowColor="#111111FF" />
      <Style Name="Link.Unit" TextColorFactor="1" FontColor="#8F4B44FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Unit.MouseOver" TextColorFactor="1.12" FontColor="#8F4B44FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Unit.MouseDown" TextColorFactor="0.72" FontColor="#8F4B44FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Concept" TextColorFactor="1" FontColor="#4C7D80FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Concept.MouseOver" TextColorFactor="1.12" FontColor="#4C7D80FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Concept.MouseDown" TextColorFactor="0.72" FontColor="#4C7D80FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Kingdom" TextColorFactor="1" FontColor="#6B7195FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Kingdom.MouseOver" TextColorFactor="1.12" FontColor="#6B7195FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Kingdom.MouseDown" TextColorFactor="0.72" FontColor="#6B7195FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Clan" TextColorFactor="1" FontColor="#466793FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Clan.MouseOver" TextColorFactor="1.12" FontColor="#466793FF" TextGlowColor="#111111FF" />
      <Style Name="Link.Clan.MouseDown" TextColorFactor="0.72" FontColor="#466793FF" TextGlowColor="#111111FF" />
    </Styles>
  </Brush>

  <!-- These weekly-only variants preserve their existing typography and body colors while inheriting the parchment-safe category palette above. -->
  <Brush Name="AnimusForge.EntityLink.WeeklyReport.PopupDescription.Text" BaseBrush="AnimusForge.EntityLink.WeeklyReport.LinkPalette" Font="FiraSansExtraCondensed-Regular" TextHorizontalAlignment="Left">
    <Styles>
      <Style Name="Default" FontColor="#F1E9DAFF" TextGlowColor="#000000FF" TextOutlineColor="#000000FF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" FontSize="20" />
    </Styles>
  </Brush>

  <Brush Name="AnimusForge.EntityLink.WeeklyReport.ParchmentBody.Text" BaseBrush="AnimusForge.EntityLink.WeeklyReport.LinkPalette" Font="simkai" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Styles>
      <Style Name="Default" FontSize="22" FontColor="#15100BFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" TextShadowOffset="0" />
    </Styles>
  </Brush>

  <Brush Name="AnimusForge.EntityLink.PopupTitle.Text" BaseBrush="Info.Text" Font="Galahad" TextHorizontalAlignment="Center">
    <Styles>
      <Style Name="Default" FontColor="#E4C59BFF" TextGlowColor="#000000FF" TextOutlineColor="#000000FF" TextOutlineAmount="0.01" TextGlowRadius="0" TextBlur="0" FontSize="36" />
    </Styles>
  </Brush>
</Brushes>

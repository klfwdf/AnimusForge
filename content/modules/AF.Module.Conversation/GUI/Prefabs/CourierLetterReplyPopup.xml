<Prefab>
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#000000FF" AlphaFactor="0.34">
      <Children>
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1180" SuggestedHeight="740" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>
            <Widget DataSource="{Theme}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true">
              <Children>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="@ScrollSprite" DoNotAcceptEvents="true" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@LeftPatternWidth" SuggestedHeight="631" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="105" MarginTop="55" Sprite="@LeftPatternSprite" DoNotAcceptEvents="true" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="@RightPatternWidth" SuggestedHeight="631" HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="109" MarginTop="55" Sprite="@RightPatternSprite" DoNotAcceptEvents="true" />
                <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="107" SuggestedHeight="107" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="837" MarginTop="505" Sprite="@SealSprite" DoNotAcceptEvents="true" />
              </Children>
            </Widget>
            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="42" HorizontalAlignment="Center" VerticalAlignment="Top" MarginLeft="235" MarginRight="235" MarginTop="104" Brush="AFCourierLetter.Title.Text" Text="@TitleText" />
            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="30" HorizontalAlignment="Center" VerticalAlignment="Top" MarginLeft="309" MarginRight="291" MarginTop="153" Brush="AFCourierLetter.Meta.Text" Text="@SubtitleText" />
            <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipRect="BodyClipRect" InnerPanel="BodyClipRect\BodyInnerPanel" MarginLeft="309" MarginRight="309" MarginTop="191" MarginBottom="170" AutoHideScrollBars="true" VerticalScrollbar="..\BodyScrollbar\Scrollbar">
              <Children>
                <Widget Id="BodyClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                  <Children>
                    <Widget Id="BodyInnerPanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MinHeight="360">
                      <Children>
                        <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MinHeight="360" HorizontalAlignment="Left" VerticalAlignment="Top" MarginRight="18" Brush="AFCourierLetter.Body.Text" Brush.FontSize="@BodyFontSize" Text="@BodyText" DoNotAcceptEvents="false" Command.LinkClick="ExecuteOpenEncyclopediaLink" Command.LinkAlternateClick="ExecuteOpenEncyclopediaLink" />
                      </Children>
                    </Widget>
                  </Children>
                </Widget>
              </Children>
            </ScrollablePanel>
            <Widget Id="BodyScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="1" HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="309" MarginTop="199" MarginBottom="178" DoNotAcceptEvents="true" IsVisible="false">
              <Children>
                <ScrollbarWidget Id="Scrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="1" AlignmentAxis="Vertical" Handle="Handle" MaxValue="100" MinValue="0" DoNotAcceptEvents="true" IsVisible="false">
                  <Children>
                    <Widget Id="Handle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1" SuggestedHeight="1" DoNotAcceptEvents="true" IsVisible="false" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </Widget>
            <!-- Impact stays separate from the letter body; long summaries scroll without losing entity links. -->
            <Widget Id="ImpactSummary" IsVisible="@HasImpact" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="245" SuggestedHeight="90" HorizontalAlignment="Left" VerticalAlignment="Top" MarginLeft="780" MarginTop="585">
              <Children>
                <ScrollablePanel Id="ImpactScrollPanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginRight="12" ClipRect="ImpactClipRect" InnerPanel="ImpactClipRect\ImpactInnerPanel" AutoHideScrollBars="true" VerticalScrollbar="..\ImpactScrollbar" DoNotAcceptEvents="false">
                  <Children>
                    <Widget Id="ImpactClipRect" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <Widget Id="ImpactInnerPanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Top">
                          <Children>
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="AFCourierLetter.Meta.Text" Text="@ImpactText" CanBreakWords="true" DoNotAcceptEvents="false" Command.LinkClick="ExecuteOpenEncyclopediaLink" Command.LinkAlternateClick="ExecuteOpenEncyclopediaLink" />
                          </Children>
                        </Widget>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="ImpactScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="8" HorizontalAlignment="Right" AlignmentAxis="Vertical" Handle="ImpactHandle" MaxValue="100" MinValue="0" Sprite="BlankWhiteSquare_9" Color="#7A5A3A55" DoNotAcceptEvents="false">
                  <Children>
                    <Widget Id="ImpactHandle" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28" Sprite="BlankWhiteSquare_9" Color="#7A5A3ABB" DoNotAcceptEvents="false" />
                  </Children>
                </ScrollbarWidget>
              </Children>
            </Widget>
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="66" LayoutImp.LayoutMethod="VerticalBottomToTop">
              <Children>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="380" SuggestedHeight="32" Brush="AFCourierLetter.Band.Button" Command.Click="ExecuteClose" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" VerticalAlignment="Center" MarginLeft="20" MarginRight="20" Brush="AFCourierLetter.Band.Button.Text" Brush.FontSize="19" Text="@CloseText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
                <Widget IsVisible="@CanReply" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1" SuggestedHeight="8" />
                <ButtonWidget IsVisible="@CanReply" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="380" SuggestedHeight="32" Brush="AFCourierLetter.Band.Button" Command.Click="ExecuteReply" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" VerticalAlignment="Center" MarginLeft="20" MarginRight="20" Brush="AFCourierLetter.Band.Button.Text" Brush.FontSize="19" Text="@ReplyText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>

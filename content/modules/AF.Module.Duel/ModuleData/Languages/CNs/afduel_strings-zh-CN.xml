    <!-- 决斗赌注结算历史模板 -->
    <string id="AF_DUEL_StakeDebtNpc" text="你在决斗中击败了 {PLAYER}，并已记下：{PLAYER} 欠你 {AMOUNT} 第纳尔{DEBT_ID}（决斗赌注）{TERM}{NOTE}。" />

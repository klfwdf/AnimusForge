tleOrContent" text="请先填写政策标题或政策内容。" /><string id="AFPOL_UI_AiDrafting" text="AI编写中…" /><string id="AFPOL_UI_AiDraftStatus" text="AI正在按照玩家可编辑提示词扩写当前内容；不会读取政策通用提示词、世界上下文或历史政策，也不会自动发布。" /><string id="AFPOL_UI_AiDraftFormChanged" text="AI编写期间表单已改变，已丢弃过期结果。" /><string id="AFPOL_UI_AiDraftFailed" text="AI编写失败，原输入已保留。" /><string id="AFPOL_UI_AiDraftCompleted" text="AI编写内容已回填；请检查并修改后再发布。" /><string id="AFPOL_UI_VassalPublishTitle" text="发布附庸国政策" /><string id="AFPOL_UI_FillForAiDraft" text="请填写政策标题或政策内容后使用AI编写。" /><string id="AFPOL_UI_AiCompleteTitle" text="可点击AI编写补全政策标题和正文。" /><string id="AFPOL_UI_AiCompleteContent" text="可点击AI编写，根据政策标题补全正文。" /><string id="AFPOL_UI_InvalidPolicyTarget" text="原目标当前无效，请明确重新选择一个当前可用目标。" /><string id="AFPOL_UI_DurationRequired" text="旧记录无法确认原持续时间，请明确填写正整数天数。" /><string id="AFPOL_UI_DurationPositive" text="持续天数必须留空或填写正整数。" /><string id="AFPOL_UI_PublishAwaitingReview" text="点击发布后将等待智能评议；成功落地时扣除已配置成本。" /><string id="AFPOL_UI_PolicyRecordsTitle" text="政策记录" /><string id="AFPOL_UI_PolicyHistoryEmpty" text="尚无成功落地的政策记录。" /><string id="AFPOL_UI_BackToPolicyManagement" text="返回政策管理" /><string id="AFPOL_UI_ReReview" text="重新评议" /><string id="AFPOL_UI_PolicyPublished" text="政策已经发布" /><string id="AFPOL_UI_Acknowledge" text="知道了" /><string id="AFPOL_UI_RetryManually" text="手动重试" /><string id="AFPOL_UI_DeleteRecord" text="删除记录" /><string id="AFPOL_UI_UnnamedPolicy" text="未命名政策" /><string id="AFPOL_UI_PolicyContentSection" text="【政策内容】" /><string id="AFPOL_UI_PolicyFeedbackSection" text="【民众反馈】" /><string id="AFPOL_UI_PolicyDailyImpactSection" text="【每日影响】" /><string id="AFPOL_UI_LocalScopeTitle" text="选择作用封地" /><string id="AFPOL_UI_SelectAll" text="全选" /><string id="AFPOL_UI_ClearSelection" text="清空" /><string id="AFPOL_UI_SelectOwnedFief" text="请至少选择一个玩家家族拥有的城镇或城堡。" /><string id="AFPOL_UI_SelectedFiefs" text="已选择 {COUNT} 个封地；作用范围由所选封地自动确定。" /><string id="AFPOL_UI_UnknownFief" text="未知封地" /><string id="AFPOL_UI_Fief" text="封地" /><string id="AFPOL_UI_LocalH
<base type="string"><tags><tag language="简体中文" /></tags><strings><string id="AFPOL_UI_BalanceDescription" text="每日按原版＋政策的净变化结算：正数最多加到总量上限；负数照常扣除，超额旧存量不削减。" /><string id="AFPOL_UI_BalanceFoodRule" text="玩家和 NPC 全部适用。默认仅开启城市／城堡粮仓容量1000，其余六项默认关闭；粮仓不叠加城堡、建筑加成。\n繁荣度耗粮由 MCM“取消繁荣度耗粮”独立开关控制，默认关闭并保留原版；与本窗口各项开关无关。驻军耗粮、围城、供粮和政策粮食变化保留。" /><string id="AFPOL_UI_BalanceInitialStatus" text="未开启的预填数值不生效。保存后应用；取消或 Esc 丢弃编辑；恢复默认后需保存。" /><string id="AFPOL_UI_BalanceIntegerRange" text="请输入 {MIN}–{MAX} 之间的整数。" /><string id="AFPOL_UI_BalanceOpenFailed" text="无法打开总量上限设置：{ERROR}" /><string id="AFPOL_UI_BalanceSaved" text="总量上限已保存；旧存量不会被削减。" /><string id="AFPOL_UI_BalanceTitle" text="政策相关数值上限调整" /><string id="AFPOL_UI_Cancel" text="取消" /><string id="AFPOL_UI_CastleMilitia" text="城堡民兵总人数" /><string id="AFPOL_UI_CastleProsperity" text="城堡繁荣度" /><string id="AFPOL_UI_CityMilitia" text="城市民兵总人数" /><string id="AFPOL_UI_CityProsperity" text="城市繁荣度" /><string id="AFPOL_UI_Disabled" text="已关闭" /><string id="AFPOL_UI_Enabled" text="已开启" /><string id="AFPOL_UI_FoodCapacity" text="城市／城堡粮食库存容量" /><string id="AFPOL_UI_FoodUnit" text="粮食（最终容量）" /><string id="AFPOL_UI_HearthUnit" text="户" /><string id="AFPOL_UI_LocalPolicy" text="地方政策" /><string id="AFPOL_UI_Module" text="模块" /><string id="AFPOL_UI_ModuleManagerDescription" text="分别控制四类新政策能检索到哪些效果。修改只在保存后生效，不会改变已有、待审或正在生成的政策。" /><string id="AFPOL_UI_ModuleManagerInitialStatus" text="所有改动都暂存在当前界面；取消或 Esc 会丢弃本次修改。" /><string id="AFPOL_UI_ModuleManagerOpenFailed" text="无法打开政策效果模块管理界面。" /><string id="AFPOL_UI_ModuleManagerSaveFailed" text="保存政策效果模块设置失败：{ERROR}" /><string id="AFPOL_UI_ModuleManagerSaved" text="政策效果模块设置已保存，仅影响之后新发起的政策。" /><string id="AFPOL_UI_ModuleManagerTitle" text="政策效果模块管理" /><string id="AFPOL_UI_NoSettingsScreen" text="没有可用的设置页面。" /><string id="AFPOL_UI_PersonUnit" text="人" /><string id="AFPOL_UI_PlayerPolicy" text="玩家政策" /><string id="AFPOL_UI_ProsperityUnit" text="繁荣度" /><string id="AFPOL_UI_RestoreDefaults" text="恢复默认" /><string id="AFPOL_UI_RestoredDefaultsStatus" text="已把工作副本恢复为所有兼容渠道开启；点击“保存并关闭”后才会写入。" /><string id="AFPOL_UI_RulerPolicy" text="统治者政策" /><string id="AFPOL_UI_SaveAndClose" text="保存并关闭" /><string id="AFPOL_UI_SaveFailed" text="保存失败：{ERROR}" /><string id="AFPOL_UI_SaveFailedShort" text="保存失败。" /><string id="AFPOL_UI_Unavailable" text="不可用" /><string id="AFPOL_UI_UnsavedStatus" text="有未保存的修改。只有新发起的政策会使用保存后的检索范围。" /><string id="AFPOL_UI_VassalPolicy" text="附庸国政策" /><string id="AFPOL_UI_VillageHearth" text="村庄户数" /><string id="AFPOL_UI_VillageMilitia" text="村庄民兵总人数" /><string id="AFPOL_UI_CapExplanation" text="玩家设置的总量瓶颈" /><string id="AFPOL_UI_DailyPatchFailed" text="总量瓶颈未启用：日结补丁安装失败，详见政策日志。" /><string id="AFPOL_UI_ProsperityFoodPatchFailed" text="无法取消繁荣耗粮：原版补丁结构不匹配；未应用估算补偿。" /><string id="AFPOL_UI_CustomFoodModelUnsupported" text="第三方粮食模型未使用原版计算，无法确认繁荣耗粮已取消。" /><string id="AFPOL_UI_WorldPolicyTitle" text="世界政策" /><string id="AFPOL_UI_WorldPolicySubtitle" text="只读查看各国已经发布的玩家与非玩家统治者政策及政策衍生事件。" /><string id="AFPOL_UI_WorldPolicyEmpty" text="暂无世界事件。统治者政策与政策衍生事件会出现在这里。" /><string id="AFPOL_UI_Close" text="关闭" /><string id="AFPOL_UI_UnknownKingdom" text="未知国家" /><string id="AFPOL_UI_WorldEvent" text="世界事件" /><string id="AFPOL_UI_Day" text="第{DAY}天" /><string id="AFPOL_UI_UnknownDate" text="未知日期" /><string id="AFPOL_UI_NoDetails" text="（无详情）" /><string id="AFPOL_UI_EventDetails" text="事件详情" /><string id="AFPOL_UI_New" text="新" /><string id="AFPOL_UI_RelatedHero" text="相关人物：{NAME}" /><string id="AFPOL_UI_Back" text="返回" /><string id="AFPOL_UI_Edit" text="编辑" /><string id="AFPOL_UI_Open" text="打开" /><string id="AFPOL_UI_Save" text="保存" /><string id="AFPOL_UI_PromptAutoDraftTitle" text="玩家 AI 编写" /><string id="AFPOL_UI_PromptAutoDraftHint" text="使用唯一的玩家可编辑提示词扩写当前输入；不会自动提交或发布。" /><string id="AFPOL_UI_PromptPlayerEvaluationTitle" text="玩家政策评议" /><string id="AFPOL_UI_PromptPlayerEvaluationHint" text="调整全国、地方和附庸政策的社会反应、成本、期限与总体强度偏好。" /><string id="AFPOL_UI_PromptNpcPolicyTitle" text="NPC 统治者政策" /><string id="AFPOL_UI_PromptNpcPolicyHint" text="调整统治者制定政策时的题材、文风、现实依据和治理取向。" /><string id="AFPOL_UI_PromptEffectRequirementsTitle" text="政策效果要求" /><string id="AFPOL_UI_PromptEffectRequirementsHint" text="按效果类别分别调整政策理解和具体强度判断；玩家与统治者政策共用。" /><string id="AFPOL_UI_PromptCommonEffectTitle" text="全部效果共同要求" /><string id="AFPOL_UI_PromptCommonEffectHint" text="只调整所有效果共用的持续时间、直接因果、多项效果和投入定标原则。" /><string id="AFPOL_UI_PromptRootTitle" text="政策提示词管理" /><string id="AFPOL_UI_PromptRootDescription" text="请选择要编辑的要求。输出格式、合法目标、效果边界和执行安全仍由模组固定保证。" /><string id="AFPOL_UI_PromptRootOpenFailed" text="打开政策提示词管理失败：{ERROR}" /><string id="AFPOL_UI_PromptAutoDraftEditorTitle" text="编辑玩家 AI 编写提示词" /><string id="AFPOL_UI_PromptAutoDraftEditorDescription" text="这里只编辑扩写方式、文风和内容偏好；玩家原文和已填写标题会另行提供。" /><string id="AFPOL_UI_PromptAutoDraftEditorHint" text="输出格式和字段由系统内置，无需也不应写入这里。留空保存会恢复默认内容。" /><string id="AFPOL_UI_PromptAutoDraftSaveFailed" text="保存玩家 AI 编写提示词失败：{ERROR}" /><string id="AFPOL_UI_PromptAutoDraftSaved" text="玩家 AI 编写提示词已保存。" /><string id="AFPOL_UI_PromptPlayerEvaluationEditorTitle" text="编辑玩家政策评议要求" /><string id="AFPOL_UI_PromptPlayerEvaluationEditorDescription" text="全国、地方和附庸政策共用这份总体评议要求。" /><string id="AFPOL_UI_PromptPlayerEvaluationEditorHint" text="适合调整执行成本、社会反应、期限、文风和总体强度偏好。留空保存会恢复默认内容。" /><string id="AFPOL_UI_PromptNpcPolicyEditorTitle" text="编辑 NPC 统治者政策要求" /><string id="AFPOL_UI_PromptNpcPolicyEditorDescription" text="这段文字指导统治者如何依据身份、性格和当前局势制定政策。" /><string id="AFPOL_UI_PromptNpcPolicyEditorHint" text="可以调整题材、文风、现实依据和治理取向。留空保存会恢复默认内容。" /><string id="AFPOL_UI_PromptEffectEntryHint" text="分别编辑发生条件和数值判定要求。" /><string id="AFPOL_UI_PromptEffectListTitle" text="政策效果要求" /><string id="AFPOL_UI_PromptEffectListDescription" text="请选择一个当前可用的效果类别。新增并启用的效果类别会自动出现在这里。" /><string id="AFPOL_UI_PromptEffectListOpenFailed" text="打开政策效果要求列表失败：{ERROR}" /><string id="AFPOL_UI_PromptCommonEffectEditorTitle" text="编辑全部效果共同要求" /><string id="AFPOL_UI_PromptCommonEffectEditorDescription" text="这段文字只规定所有效果共
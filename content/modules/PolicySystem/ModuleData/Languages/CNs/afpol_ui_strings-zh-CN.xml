<base type="string"><tags><tag language="简体中文" /></tags><strings><string id="AFPOL_UI_BalanceDescription" text="每日按原版＋政策的净变化结算：正数最多加到总量上限；负数照常扣除，超额旧存量不削减。" /><string id="AFPOL_UI_BalanceFoodRule" text="玩家和 NPC 全部适用。默认仅开启城市／城堡粮仓容量1000，其余六项默认关闭；粮仓不叠加城堡、建筑加成。\n繁荣度耗粮由 MCM“取消繁荣度耗粮”独立开关控制，默认关闭并保留原版；与本窗口各项开关无关。驻军耗粮、围城、供粮和政策粮食变化保留。" /><string id="AFPOL_UI_BalanceInitialStatus" text="未开启的预填数值不生效。保存后应用；取消或 Esc 丢弃编辑；恢复默认后需保存。" /><string id="AFPOL_UI_BalanceIntegerRange" text="请输入 {MIN}–{MAX} 之间的整数。" /><string id="AFPOL_UI_BalanceOpenFailed" text="无法打开总量上限设置：{ERROR}" /><string id="AFPOL_UI_BalanceSaved" text="总量上限已保存；旧存量不会被削减。" /><string id="AFPOL_UI_BalanceTitle" text="政策相关数值上限调整" /><string id="AFPOL_UI_Cancel" text="取消" /><string id="AFPOL_UI_CastleMilitia" text="城堡民兵总人数" /><string id="AFPOL_UI_CastleProsperity" text="城堡繁荣度" /><string id="AFPOL_UI_CityMilitia" text="城市民兵总人数" /><string id="AFPOL_UI_CityProsperity" text="城市繁荣度" /><string id="AFPOL_UI_Disabled" text="已关闭" /><string id="AFPOL_UI_Enabled" text="已开启" /><string id="AFPOL_UI_FoodCapacity" text="城市／城堡粮食库存容量" /><string id="AFPOL_UI_FoodUnit" text="粮食（最终容量）" /><string id="AFPOL_UI_HearthUnit" text="户" /><string id="AFPOL_UI_LocalPolicy" text="地方政策" /><string id="AFPOL_UI_Module" text="模块" /><string id="AFPOL_UI_ModuleManagerDescription" text="分别控制四类新政策能检索到哪些效果。修改只在保存后生效，不会改变已有、待审或正在生成的政策。" /><string id="AFPOL_UI_ModuleManagerInitialStatus" text="所有改动都暂存在当前界面；取消或 Esc 会丢弃本次修改。" /><string id="AFPOL_UI_ModuleManagerOpenFailed" text="无法打开政策效果模块管理界面。" /><string id="AFPOL_UI_ModuleManagerSaveFailed" text="保存政策效果模块设置失败：{ERROR}" /><string id="AFPOL_UI_ModuleManagerSaved" text="政策效果模块设置已保存，仅影响之后新发起的政策。" /><string id="AFPOL_UI_ModuleManagerTitle" text="政策效果模块管理" /><string id="AFPOL_UI_NoSettingsScreen" text="没有可用的设置页面。" /><string id="AFPOL_UI_PersonUnit" text="人" /><string id="AFPOL_UI_PlayerPolicy" text="玩家政策" /><string id="AFPOL_UI_ProsperityUnit" text="繁荣度" /><string id="AFPOL_UI_RestoreDefaults" text="恢复默认" /><string id="AFPOL_UI_RestoredDefaultsStatus" text="已把工作副本恢复为所有兼容渠道开启；点击“保存并关闭”后才会写入。" /><string id="AFPOL_UI_RulerPolicy" text="统治者政策" /><string id="AFPOL_UI_SaveAndClose" text="保存并关闭" /><string id="AFPOL_UI_SaveFailed" text="保存失败：{ERROR}" /><string id="AFPOL_UI_SaveFailedShort" text="保存失败。" /><string id="AFPOL_UI_Unavailable" text="不可用" /><string id="AFPOL_UI_UnsavedStatus" text="有未保存的修改。只有新发起的政策会使用保存后的检索范围。" /><string id="AFPOL_UI_VassalPolicy" text="附庸国政策" /><string id="AFPOL_UI_VillageHearth" text="村庄户数" /><string id="AFPOL_UI_VillageMilitia" text="村庄民兵总人数" /><string id="AFPOL_UI_CapExplanation" text="玩家设置的总量瓶颈" /><string id="AFPOL_UI_DailyPatchFailed" text="总量瓶颈未启用：日结补丁安装失败，详见政策日志。" /><string id="AFPOL_UI_ProsperityFoodPatchFailed" text="无法取消繁荣耗粮：原版补丁结构不匹配；未应用估算补偿。" /><string id="AFPOL_UI_CustomFoodModelUnsupported" text="第三方粮食模型未使用原版计算，无法确认繁荣耗粮已取消。" /><string id="AFPOL_UI_WorldPolicyTitle" text="世界政策" /><string id="AFPOL_UI_WorldPolicySubtitle" text="只读查看各国已经发布的玩家与非玩家统治者政策及政策衍生事件。" /><string id="AFPOL_UI_WorldPolicyEmpty" text="暂无世界事件。统治者政策与政策衍生事件会出现在这里。" /><string id="AFPOL_UI_Close" text="关闭" /><string id="AFPOL_UI_UnknownKingdom" text="未知国家" /><string id="AFPOL_UI_WorldEvent" text="世界事件" /><string id="AFPOL_UI_Day" text="第{DAY}天" /><string id="AFPOL_UI_UnknownDate" text="未知日期" /><string id="AFPOL_UI_NoDetails" text="（无详情）" /><string id="AFPOL_UI_EventDetails" text="事件详情" /><string id="AFPOL_UI_New" text="新" /><string id="AFPOL_UI_RelatedHero" text="相关人物：{NAME}" /></strings></base>
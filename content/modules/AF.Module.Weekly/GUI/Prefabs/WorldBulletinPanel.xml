<Prefab>
  <!-- Layout mirrors pencil-new.pen frame sAH0C (1920×1080 新快报面板 v3｜列国邸报 · 铜版雕刻做旧): 1280x814 sheet on the 1730x1100 wide plate (ornaments kept at native ratio). -->
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
      <Children>
        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1280" SuggestedHeight="814" HorizontalAlignment="Center" VerticalAlignment="Center">
          <Children>
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="af_world_bulletin\af_world_bulletin_parchment" DoNotAcceptEvents="true" />

            <!-- Masthead: title sits on the engraved ribbon baked into the parchment -->
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="600" SuggestedHeight="19" MarginLeft="340" MarginTop="102" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="13" Brush.FontColor="#9B2A1EFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="@MastheadText" DoNotAcceptEvents="true" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="400" SuggestedHeight="63" MarginLeft="440" MarginTop="131" Brush="AFCourierLetter.Title.Text" Brush.FontSize="44" Brush.FontColor="#2B1C10FF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="@TitleText" DoNotAcceptEvents="true" />
            <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="300" SuggestedHeight="16" MarginLeft="490" MarginTop="216" Brush="AnimusForge.EntityLink.PopupTitle.Text" Brush.FontSize="15" Brush.FontColor="#5A4028FF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="Chronica  Regnorum" DoNotAcceptEvents="true" />

            <!-- Main row: optional illustration column + lead story -->
            <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1078" SuggestedHeight="318" MarginLeft="94" MarginTop="247" LayoutImp.LayoutMethod="HorizontalLeftToRight">
              <Children>
                <Widget DataSource="{Illustration}" IsVisible="@IsAvailable" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="428" SuggestedHeight="318">
                  <Children>
                    <!-- 368x207 image aperture: the same 16:9 ratio requested from the image provider. -->
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="400" SuggestedHeight="239">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#A8843CFF" DoNotAcceptEvents="true" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="8" MarginRight="8" MarginTop="8" MarginBottom="8" Sprite="BlankWhiteSquare_9" Color="#7E2418FF" DoNotAcceptEvents="true" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="14" MarginRight="14" MarginTop="14" MarginBottom="14" Sprite="BlankWhiteSquare_9" Color="#C9A456FF" DoNotAcceptEvents="true" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="16" MarginRight="16" MarginTop="16" MarginBottom="16" Sprite="BlankWhiteSquare_9" Color="#3A2616FF" DoNotAcceptEvents="true" />
                        <Widget IsVisible="@HasIllustration" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="16" MarginRight="16" MarginTop="16" MarginBottom="16" Sprite="@SpriteName" ImageFit.Type="Contain" DoNotAcceptEvents="true" />
                        <Widget IsVisible="@ShowPlaceholder" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="17" MarginRight="17" MarginTop="17" MarginBottom="17" DoNotAcceptEvents="true">
                          <Children>
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" MarginLeft="20" MarginRight="20" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="14" Brush.FontColor="#E8D6B0FF" Brush.TextHorizontalAlignment="Center" Text="@StatusText" DoNotAcceptEvents="true" />
                          </Children>
                        </Widget>
                        <Widget IsVisible="@ShowPrompt" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="17" MarginRight="17" MarginTop="17" MarginBottom="17" Sprite="BlankWhiteSquare_9" Color="#15100BE6">
                          <Children>
                            <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="12" MarginRight="12" MarginTop="10" MarginBottom="40" ClipRect="PromptClip" InnerPanel="PromptClip\PromptInner" AutoHideScrollBars="true">
                              <Children>
                                <Widget Id="PromptClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                                  <Children>
                                    <Widget Id="PromptInner" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
                                      <Children>
                                        <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="12" Brush.FontColor="#E8D6B0FF" Text="@PromptText" CanBreakWords="true" DoNotAcceptEvents="true" />
                                      </Children>
                                    </Widget>
                                  </Children>
                                </Widget>
                              </Children>
                            </ScrollablePanel>
                            <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="110" SuggestedHeight="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="10" MarginBottom="8" Command.Click="ExecuteCopyPrompt">
                              <Children>
                                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="AFCourierLetter.Button.Text" Brush.FontSize="13" Brush.FontColor="#E8C66AFF" Text="复制提示词" DoNotAcceptEvents="true" />
                              </Children>
                            </ButtonWidget>
                          </Children>
                        </Widget>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24" PositionXOffset="-4" PositionYOffset="-4" Sprite="BlankWhiteSquare_9" Color="#D9B560FF" DoNotAcceptEvents="true"><Children><Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="8" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#8E2A1EFF" /></Children></Widget>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24" PositionXOffset="380" PositionYOffset="-4" Sprite="BlankWhiteSquare_9" Color="#D9B560FF" DoNotAcceptEvents="true"><Children><Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="8" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#8E2A1EFF" /></Children></Widget>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24" PositionXOffset="-4" PositionYOffset="219" Sprite="BlankWhiteSquare_9" Color="#D9B560FF" DoNotAcceptEvents="true"><Children><Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="8" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#8E2A1EFF" /></Children></Widget>
                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24" PositionXOffset="380" PositionYOffset="219" Sprite="BlankWhiteSquare_9" Color="#D9B560FF" DoNotAcceptEvents="true"><Children><Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="8" SuggestedHeight="8" HorizontalAlignment="Center" VerticalAlignment="Center" Sprite="BlankWhiteSquare_9" Color="#8E2A1EFF" /></Children></Widget>
                      </Children>
                    </Widget>
                    <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="17" MarginTop="250" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="12" Brush.FontColor="#6B4E30FF" Brush.TextVerticalAlignment="Center" Text="@CaptionText" DoNotAcceptEvents="true" />
                    <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="17" MarginTop="276" MarginRight="28" HorizontalAlignment="Right" LayoutImp.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="17" Command.Click="ExecuteRegenerate" IsEnabled="@CanRegenerate">
                          <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="AFCourierLetter.Button.Text" Brush.FontSize="12" Brush.FontColor="#9B2A1EFF" Text="重绘" DoNotAcceptEvents="true" /></Children>
                        </ButtonWidget>
                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="16" SuggestedHeight="17" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="12" Brush.FontColor="#9B2A1EFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="·" DoNotAcceptEvents="true" />
                        <ButtonWidget IsEnabled="@CanRegenerateWithPrompt" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="116" SuggestedHeight="17" Command.Click="ExecuteRegenerateWithPrompt">
                          <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="AFCourierLetter.Button.Text" Brush.FontSize="12" Brush.FontColor="#9B2A1EFF" Text="重绘（带提示词）" DoNotAcceptEvents="true" /></Children>
                        </ButtonWidget>

                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="16" SuggestedHeight="17" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="12" Brush.FontColor="#9B2A1EFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="·" DoNotAcceptEvents="true" />
                        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="17" Command.Click="ExecuteOpenGallery">
                          <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="AFCourierLetter.Button.Text" Brush.FontSize="12" Brush.FontColor="#9B2A1EFF" Text="画廊" DoNotAcceptEvents="true" /></Children>
                        </ButtonWidget>
                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="16" SuggestedHeight="17" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="12" Brush.FontColor="#9B2A1EFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="·" DoNotAcceptEvents="true" />
                        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="32" SuggestedHeight="17" Command.Click="ExecuteDelete" IsEnabled="@HasIllustration">
                          <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="AFCourierLetter.Button.Text" Brush.FontSize="12" Brush.FontColor="#9B2A1EFF" Text="删除" DoNotAcceptEvents="true" /></Children>
                        </ButtonWidget>
                      </Children>
                    </ListPanel>
                  </Children>
                </Widget>
                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="19" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="13" Brush.FontColor="#9B2A1EFF" Brush.TextVerticalAlignment="Center" Text="@KindText" DoNotAcceptEvents="true" />
                    <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="68" MarginTop="27" Brush="AFCourierLetter.Title.Text" Brush.FontSize="28" Brush.FontColor="#2B1C10FF" Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Center" Text="@HeadlineText" DoNotAcceptEvents="true" />
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="17" MarginTop="103" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="12" Brush.FontColor="#6B4E30FF" Brush.TextVerticalAlignment="Center" Text="@MetaText" DoNotAcceptEvents="true" />
                    <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="190" MarginTop="128" ClipRect="BodyClip" InnerPanel="BodyClip\BodyInner" AutoHideScrollBars="true" VerticalScrollbar="..\BodyScrollbar\Scrollbar">
                      <Children>
                        <Widget Id="BodyClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                          <Children>
                            <Widget Id="BodyInner" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
                              <Children>
                                <WorldBulletinBodyWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="64" BodyText="@BodyText" DropCapText="@DropCapText" LeadText="Lead" TailText="Tail" DropCap="Cap" DoNotAcceptEvents="true" DoNotPassEventsToChildren="false">
                                  <Children>
                                    <TextWidget Id="Cap" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="54" SuggestedHeight="54" Brush="AFCourierLetter.Title.Text" Brush.FontSize="46" Brush.FontColor="#35261AFF" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" />
                                    <RichTextWidget Id="Lead" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="54" MarginRight="6" Brush="AnimusForge.EntityLink.WeeklyReport.ParchmentBody.Text" Brush.FontSize="@BodyFontSize" Brush.FontColor="#35261AFF" Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Top" CanBreakWords="true" DoNotAcceptEvents="false" Command.LinkClick="ExecuteOpenEncyclopediaLink" Command.LinkAlternateClick="ExecuteOpenEncyclopediaLink" />
                                    <RichTextWidget Id="Tail" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="1" MarginRight="6" Brush="AnimusForge.EntityLink.WeeklyReport.ParchmentBody.Text" Brush.FontSize="@BodyFontSize" Brush.FontColor="#35261AFF" Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Top" CanBreakWords="true" DoNotAcceptEvents="false" Command.LinkClick="ExecuteOpenEncyclopediaLink" Command.LinkAlternateClick="ExecuteOpenEncyclopediaLink" />
                                  </Children>
                                </WorldBulletinBodyWidget>
                              </Children>
                            </Widget>
                          </Children>
                        </Widget>
                      </Children>
                    </ScrollablePanel>
                    <Widget Id="BodyScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1" SuggestedHeight="190" HorizontalAlignment="Right" MarginTop="128" DoNotAcceptEvents="true" IsVisible="false">
                      <Children>
                        <ScrollbarWidget Id="Scrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="1" AlignmentAxis="Vertical" Handle="Handle" MaxValue="100" MinValue="0" DoNotAcceptEvents="true" IsVisible="false">
                          <Children>
                            <Widget Id="Handle" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1" SuggestedHeight="1" DoNotAcceptEvents="true" IsVisible="false" />
                          </Children>
                        </ScrollbarWidget>
                      </Children>
                    </Widget>
                  </Children>
                </Widget>
              </Children>
            </ListPanel>

            <!-- Other news: title sits on the small ribbon baked into the parchment -->
            <Widget IsVisible="@HasMinors" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1078" SuggestedHeight="100" HorizontalAlignment="Center" MarginTop="593" DoNotAcceptEvents="false">
              <Children>
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="219" SuggestedHeight="30" HorizontalAlignment="Center" Brush="AFCourierLetter.Title.Text" Brush.FontSize="20" Brush.FontColor="#2B1C10FF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="其 余 消 息" DoNotAcceptEvents="true" />
                <ScrollablePanel Id="MinorScrollPanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="68" MarginTop="32" ClipRect="MinorClip" InnerPanel="MinorClip\MinorInner" VerticalScrollbar="..\MinorScrollbar" AutoHideScrollBars="true" DoNotAcceptEvents="false">
                  <Children>
                    <Widget Id="MinorClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                      <Children>
                        <Widget Id="MinorInner" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren">
                          <Children>
                <ListPanel DataSource="{LeftMinors}" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="529" HorizontalAlignment="Left" LayoutImp.LayoutMethod="VerticalTopToBottom">
                  <ItemTemplate>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="6" LayoutImp.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="72" SuggestedHeight="26" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="18" Brush.FontColor="#9B2A1EFF" Brush.TextVerticalAlignment="Center" Text="@TagText" DoNotAcceptEvents="true" />
                        <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MinHeight="26" Brush="AnimusForge.EntityLink.WeeklyReport.ParchmentBody.Text" Brush.FontSize="18" Brush.FontColor="#35261AFF" Brush.TextVerticalAlignment="Center" Text="@Text" CanBreakWords="true" DoNotAcceptEvents="false" Command.LinkClick="ExecuteOpenEncyclopediaLink" Command.LinkAlternateClick="ExecuteOpenEncyclopediaLink" />
                      </Children>
                    </ListPanel>
                  </ItemTemplate>
                </ListPanel>
                <ListPanel DataSource="{RightMinors}" WidthSizePolicy="Fixed" HeightSizePolicy="CoverChildren" SuggestedWidth="529" HorizontalAlignment="Right" LayoutImp.LayoutMethod="VerticalTopToBottom">
                  <ItemTemplate>
                    <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MarginBottom="6" LayoutImp.LayoutMethod="HorizontalLeftToRight">
                      <Children>
                        <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="72" SuggestedHeight="26" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="18" Brush.FontColor="#9B2A1EFF" Brush.TextVerticalAlignment="Center" Text="@TagText" DoNotAcceptEvents="true" />
                        <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" MinHeight="26" Brush="AnimusForge.EntityLink.WeeklyReport.ParchmentBody.Text" Brush.FontSize="18" Brush.FontColor="#35261AFF" Brush.TextVerticalAlignment="Center" Text="@Text" CanBreakWords="true" DoNotAcceptEvents="false" Command.LinkClick="ExecuteOpenEncyclopediaLink" Command.LinkAlternateClick="ExecuteOpenEncyclopediaLink" />
                      </Children>
                    </ListPanel>
                  </ItemTemplate>
                </ListPanel>
                          </Children>
                        </Widget>
                      </Children>
                    </Widget>
                  </Children>
                </ScrollablePanel>
                <ScrollbarWidget Id="MinorScrollbar" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="4" SuggestedHeight="68" HorizontalAlignment="Right" MarginTop="32" AlignmentAxis="Vertical" Handle="MinorHandle" MinValue="0" MaxValue="100" ValueFloat="@MinorScrollPosition" DoNotAcceptEvents="false">
                  <Children><Widget Id="MinorHandle" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="18" Sprite="BlankWhiteSquare_9" Color="#87633CFF" DoNotAcceptEvents="false" /></Children>
                </ScrollbarWidget>
              </Children>
            </Widget>

            <!-- Footer -->
            <ButtonWidget Id="ArchiveBulletinButton" IsVisible="@ShowCloseButton" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="154" SuggestedHeight="38" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="76" Brush="AFWorldBulletin.Archive.Button" Command.Click="ExecuteClose" UpdateChildrenStates="true">
              <Children>
                <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Brush="AFCourierLetter.Button.Text" Brush.FontSize="16" Brush.FontColor="#4A2E1CFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="@CloseText" DoNotAcceptEvents="true" />
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="18" MarginLeft="4" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="9" Brush.FontColor="#87633CFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="◆" DoNotAcceptEvents="true" />
                <TextWidget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="18" MarginRight="4" HorizontalAlignment="Right" Brush="AFCourierLetter.Meta.Text" Brush.FontSize="9" Brush.FontColor="#87633CFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" Text="◆" DoNotAcceptEvents="true" />
              </Children>
            </ButtonWidget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>

    <string id="AF_DIP_EVENT_PreviewRemovePressure" text="北帝国 · 边境承压：移除繁荣增长惩罚" />
    <string id="AF_DIP_EVENT_PreviewRecovery" text="南北两国 · 战后休整：开始施加临时恢复效果" />

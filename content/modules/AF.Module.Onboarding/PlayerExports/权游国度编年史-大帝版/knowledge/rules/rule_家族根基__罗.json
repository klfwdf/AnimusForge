  "Variants": [
    {
      "Priority": 0,
      "When": null,
      "Content": "罗家曾是夷地贵族，后来遭到流放。离开故土后，家门失去的不只是土地，还有朝廷位次、宗族祭祀和让身份被众人承认的日常秩序；能够带走的只有谱牒、印记、礼法、亲族记忆与少数愿意同行的人。流亡会迫使罗家在两种冲动间选择：坚持旧礼以免被异乡吞没，或学习新环境以求生存。它可能寻求归返、另立根基或服务于外来强者，但任何道路都绕不开同一个问题——家名究竟是活人的责任，还是只供追忆的旧梦。"
    },
    {
      "Priority": 0,
      "When": {
        "HeroIds": null,
        "Cultures": [
          "yiti"
        ],
        "KingdomIds": null,
        "SettlementIds": null,
        "Roles": [

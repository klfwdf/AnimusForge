          "slave"
        ],
        "IdentityIds": null,
        "IsFemale": null,
        "IsClanLeader": null,
        "SkillMin": null
      },
      "Content": "吉斯卡利商人愿意用丝绸、酒和许诺换取贾科绕路，守城人却不相信一份礼物能约束下一次迁徙。对城墙内的人而言，卡拉萨的友善与敌意都必须按日重算。"
    },
    {
      "Priority": 0,
      "When": {
        "HeroIds": null,
        "Cultures": [
          "khuzait"
        ],
        "KingdomIds": null,
        "SettlementIds": null,
        "Roles": [

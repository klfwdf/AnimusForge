        ],
        "IdentityIds": null,
        "IsFemale": null,
        "IsClanLeader": null,
        "SkillMin": null
      },
      "Content": "农户和匠人把阿莱休的荣辱记在水渠、磨坊与欠薪上。肯修复一处公共工程的家门，会比在废墟上举办十次盛宴更接近复兴。"
    },
    {
      "Priority": 0,
      "When": {
        "HeroIds": null,
        "Cultures": [
          "sarnor"
        ],
        "KingdomIds": null,
        "SettlementIds": null,
        "Roles": [

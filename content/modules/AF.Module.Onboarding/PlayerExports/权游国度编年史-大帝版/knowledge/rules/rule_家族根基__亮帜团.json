          "merchant"
        ],
        "IdentityIds": null,
        "IsFemale": null,
        "IsClanLeader": null,
        "SkillMin": null
      },
      "Content": "自由城邦的富商和执政者愿意雇亮帜团，因为临时购得的兵力比长期养军便宜；他们也害怕合同到期后，这群全副武装的人仍站在城门外。"
    },
    {
      "Priority": 0,
      "When": {
        "HeroIds": null,
        "Cultures": null,
        "KingdomIds": null,
        "SettlementIds": null,
        "Roles": [

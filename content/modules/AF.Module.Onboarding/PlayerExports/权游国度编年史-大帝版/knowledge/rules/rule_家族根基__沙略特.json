        "IdentityIds": null,
        "IsFemale": null,
        "IsClanLeader": null,
        "SkillMin": null
      },
      "Content": "银山矿工知道每一枚亮银背后都有粉尘、塌方和伤腿。他们不反对领主获利，却会记住谁为死者家眷留下粮食，谁只在矿车装满时才想起他们。"
    },
    {
      "Priority": 0,
      "When": {
        "HeroIds": null,
        "Cultures": null,
        "KingdomIds": null,
        "SettlementIds": null,
        "Roles": [

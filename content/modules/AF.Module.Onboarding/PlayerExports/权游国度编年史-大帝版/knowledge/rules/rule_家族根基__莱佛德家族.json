          "river"
        ],
        "KingdomIds": null,
        "SettlementIds": null,
        "Roles": [
          "merchant",
          "soldier"
        ],
        "IdentityIds": null,
        "IsFemale": null,
        "IsClanLeader": null,
        "SkillMin": null
      },
      "Content": "商人把金牙城看成必须付钱也必须尊重的门，士兵则把它看成山路上最先出现的高墙。关卡太松会招来敌人，太紧会让货物绕道；莱佛德每次开门，都在安全与收入之间称量。"
    },
    {
      "Priority": 0,
      "When": {
        "HeroIds": null,
        "Cultures": null,
        "KingdomIds": null,
        "SettlementIds": null,
        "Roles": [

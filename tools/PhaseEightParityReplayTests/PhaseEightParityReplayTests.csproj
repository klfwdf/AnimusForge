<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <Import Project="..\ReplayDependencies\BannerlordReplayDependencies.targets" />
  <ItemGroup>
    <Compile Include="..\ProductionOptInEntryReplayTests\WeeklyActionOutcomeProductionReplay.cs" Link="WeeklyActionOutcomeProductionReplay.cs" />
  </ItemGroup>
  <PropertyGroup>
    <_ReplayImplementationPath Condition="'$(ReplayCandidateDll)' != ''">$(ReplayCandidateDll)</_ReplayImplementationPath>
  </PropertyGroup>
  <Target Name="RequirePhaseEightCandidate" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ReplayCandidateDll)' == ''" Text="PhaseEight replay requires explicit -p:ReplayCandidateDll from the current single_module_artifacts build." />
  </Target>
</Project>

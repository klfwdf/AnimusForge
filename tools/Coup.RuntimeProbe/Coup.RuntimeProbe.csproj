<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>Coup.RuntimeProbe</AssemblyName>
    <NuGetAudit>false</NuGetAudit>
    <GameRoot Condition="'$(GameRoot)' == ''">F:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</GameRoot>
    <HarmonyCorePath Condition="'$(HarmonyCorePath)' == ''">$(GameRoot)\Modules\Bannerlord.Harmony\bin\Win64_Shipping_Client\0Harmony.dll</HarmonyCorePath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="0Harmony">
      <HintPath>$(HarmonyCorePath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>

<Brushes>
  <Brush Name="AFCourierLetter.Title.Text" Font="simkai" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontSize="34" FontColor="#15100BFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" TextShadowOffset="0" />
    </Styles>
  </Brush>

  <Brush Name="AFCourierLetter.Meta.Text" Font="simkai" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Styles>
      <Style Name="Default" FontSize="20" FontColor="#15100BFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" TextShadowOffset="0" />
    </Styles>
  </Brush>

  <Brush Name="AFCourierLetter.Body.Text" Font="simkai" TextHorizontalAlignment="Left" TextVerticalAlignment="Top">
    <Styles>
      <Style Name="Default" FontSize="22" FontColor="#15100BFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" TextShadowOffset="0" />
    </Styles>
  </Brush>

  <Brush Name="AFCourierLetter.Button.Text" Font="simkai" TextHorizontalAlignment="Center" TextVerticalAlignment="Center">
    <Styles>
      <Style Name="Default" FontSize="22" FontColor="#15100BFF" TextOutlineAmount="0" TextGlowRadius="0" TextBlur="0" TextShadowOffset="0" />
      <Style Name="Hovered" FontColor="#2B2117FF" />
      <Style Name="Pressed" FontColor="#0D0906FF" />
      <Style Name="Disabled" FontColor="#15100B88" />
    </Styles>
  </Brush>
</Brushes>

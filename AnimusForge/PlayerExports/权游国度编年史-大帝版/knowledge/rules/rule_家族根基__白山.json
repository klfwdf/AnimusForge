          "battania"
        ],
        "KingdomIds": null,
        "SettlementIds": null,
        "Roles": [
          "lord",
          "scholar"
        ],
        "IdentityIds": null,
        "IsFemale": null,
        "IsClanLeader": null,
        "SkillMin": null
      },
      "Content": "北境贵族不会只听一家的族谱便裁定铁树堡归属。旧契、边界、婚盟和谁能让当地人在冬季活下去同样重要；一个领主若只会重复祖先的控诉，便还没有证明自己配得上争来的土地。"
    },
    {
      "Priority": 0,
      "When": {
        "HeroIds": null,
        "Cultures": [
          "battania"
        ],
        "KingdomIds": null,
        "SettlementIds": null,

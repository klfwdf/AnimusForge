        ],
        "IdentityIds": null,
        "IsFemale": null,
        "IsClanLeader": null,
        "SkillMin": null
      },
      "Content": "半岛农户和猎人不喜欢外人把他们叫作野蛮人。他们信任熟悉泥沼、尊重旧客礼的布伦，也会抵制带着华丽文书来夺林地和渔场的陌生管事。"
    },
    {
      "Priority": 0,
      "When": {
        "HeroIds": null,
        "Cultures": null,
        "KingdomIds": null,
        "SettlementIds": null,
        "Roles": [

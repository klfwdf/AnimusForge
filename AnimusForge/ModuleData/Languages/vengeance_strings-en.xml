      <!-- Short scene speech: legacy address keys above remain for compatibility. -->
    <string id="REX_Speech2_Address_Alleged_1" text="{VICTIM}, the charge is {CHARGE}." />
    <string id="REX_Speech2_Address_Alleged_2" text="{VICTIM}, hear the charge: {CHARGE}." />
    <string id="REX_Speech2_Address_Alleged_3" text="The sentence names {VICTIM}. The charge: {CHARGE}." />
    <string id="REX_Speech2_Address_Alleged_4" text="{VICTIM} stands condemned on the charge of {CHARGE}." />
    <string id="REX_Speech2_Address_Recorded_1" text="{VICTIM}: {CHARGE}, recorded at {EVIDENCE_PLACE}." />
    <string id="REX_Speech2_Address_Recorded_2" text="{VICTIM}, the record at {EVIDENCE_PLACE} concerns {CHARGE}." />
    <string id="REX_Speech2_Address_Recorded_3" text="{VICTIM}, this sentence concerns {CHARGE} at {EVIDENCE_PLACE}." />
    <string id="REX_Speech2_Address_Recorded_4" text="The record names {VICTIM}: {CHARGE}, at {EVIDENCE_PLACE}." />
    <string id="REX_Speech2_Verdict_Judicial_1" text="By order of {EXECUTOR}: {METHOD}." />
    <string id="REX_Speech2_Verdict_Judicial_2" text="{EXECUTOR} has ordered the sentence: {METHOD}." />
    <string id="REX_Speech2_Verdict_Judicial_3" text="The sentence is {METHOD}, by order of {EXECUTOR}." />
    <string id="REX_Speech2_Verdict_Judicial_4" text="The order of {EXECUTOR} is read: {METHOD}." />
    <string id="REX_Speech2_Verdict_Spectacle_1" text="All here shall witness {EXECUTOR}&apos;s sentence: {METHOD}." />
    <string id="REX_Speech2_Verdict_Spectacle_2" text="Hear the public sentence of {EXECUTOR}: {METHOD}." />
    <string id="REX_Speech2_Verdict_Spectacle_3" text="Before those gathered, {EXECUTOR} orders {METHOD}." />
    <string id="REX_Speech2_Verdict_Spectacle_4" text="Let the sentence be heard: {METHOD}, ordered by {EXECUTOR}." />
    <string id="REX_Speech2_Verdict_Terror_1" text="Remember this sentence. By {EXECUTOR}&apos;s order: {METHOD}." />
    <string id="REX_Speech2_Verdict_Terror_2" text="Hear {EXECUTOR}&apos;s warning. The sentence is {METHOD}." />
    <string id="REX_Speech2_Verdict_Terror_3" text="Let this be a warning: {METHOD}, ordered by {EXECUTOR}." />
    <string id="REX_Speech2_Verdict_Terror_4" text="{EXECUTOR} orders {METHOD}. Remember what you see." />
    <string id="REX_Speech2_Victim_Bold_Honorable_1" text="I heard the sentence. I will not beg." />
    <string id="REX_Speech2_Victim_Bold_Honorable_2" text="Fear will not choose my last words." />
    <string id="REX_Speech2_Victim_Bold_Honorable_3" text="Carry out the sentence. I will keep my composure." />
    <string id="REX_Speech2_Victim_Bold_Honorable_4" text="My life is yours. My words remain my own." />
    <string id="REX_Speech2_Victim_Bold_1" text="I heard you. Keep your hands steady." />
    <string id="REX_Speech2_Victim_Bold_2" text="Read your sentence. I will not beg." />
    <string id="REX_Speech2_Victim_Bold_3" text="You have your order. I will not bow." />
    <string id="REX_Speech2_Victim_Bold_4" text="Look closely. I will not beg for pity." />
    <string id="REX_Speech2_Victim_Fearful_Honorable_1" text="My voice may shake. I would still have you hear it." />
    <string id="REX_Speech2_Victim_Fearful_Honorable_2" text="Give me a breath. I would face this as steadily as I can." />
    <string id="REX_Speech2_Victim_Fearful_Honorable_3" text="I am afraid. I will not pretend otherwise." />
    <string id="REX_Speech2_Victim_Fearful_Honorable_4" text="A moment, please. Let me gather myself before the end." />
    <string id="REX_Speech2_Victim_Fearful_1" text="Wait. Please, give me another moment." />
    <string id="REX_Speech2_Victim_Fearful_2" text="Must it be now? I am not ready." />
    <string id="REX_Speech2_Victim_Fearful_3" text="Please do not rush. I need to catch my breath." />
    <string id="REX_Speech2_Victim_Fearful_4" text="I hear you. Just... let me breathe." />
    <string id="REX_Speech2_Victim_Steady_Honorable_1" text="I have heard the judgement. There is little more to say." />
    <string id="REX_Speech2_Victim_Steady_Honorable_2" text="Let my final words be my own. That is all I ask." />
    <string id="REX_Speech2_Victim_Steady_Honorable_3" text="I will answer in my own words, while I still can." />
    <string id="REX_Speech2_Victim_Steady_Honorable_4" text="I understand the order. I will keep my dignity." />
    <string id="REX_Speech2_Victim_Steady_1" text="The words are clear enough. I have heard them." />
    <string id="REX_Speech2_Victim_Steady_2" text="There is no need to read it twice." />
    <string id="REX_Speech2_Victim_Steady_3" text="So that is the sentence. I have nothing to add." />
    <string id="REX_Speech2_Victim_Steady_4" text="I hear what has been ordered." />
    <string id="REX_Speech2_Victim_Neutral_1" text="I have heard the sentence." />
    <string id="REX_Speech2_Victim_Neutral_2" text="Give me a moment." />
    <string id="REX_Speech2_Victim_Neutral_3" text="Is there anything more to read?" />
    <string id="REX_Speech2_Victim_Neutral_4" text="Then there is little left to say." />
    <string id="REX_Speech2_Victim_NoEvidence_1" text="An accusation is not proof." />
    <string id="REX_Speech2_Victim_NoEvidence_2" text="Naming a charge proves nothing." />
    <string id="REX_Speech2_Victim_NoEvidence_3" text="I will not confess on command." />
    <string id="REX_Speech2_Victim_NoEvidence_4" text="My silence is not consent." />
    <string id="REX_Speech2_Victim_WeakEvidence_1" text="Doubt is not proof." />
    <string id="REX_Speech2_Victim_WeakEvidence_2" text="Suspicions are not enough." />
    <string id="REX_Speech2_Victim_WeakEvidence_3" text="Your doubts are not settled." />
    <string id="REX_Speech2_Victim_WeakEvidence_4" text="An accusation needs proof." />
    <string id="REX_Speech2_Victim_StrongEvidence_1" text="I am more than this." />
    <string id="REX_Speech2_Victim_StrongEvidence_2" text="I have heard the sentence." />
    <string id="REX_Speech2_Victim_StrongEvidence_3" text="These words are not everything." />
    <string id="REX_Speech2_Victim_StrongEvidence_4" text="I will not argue now." />
    <string id="REX_Speech2_Victim_Friendly_1" text="{EXECUTOR}, hear me." />
    <string id="REX_Speech2_Victim_Friendly_2" text="{EXECUTOR}, a moment." />
    <string id="REX_Speech2_Victim_Friendly_3" text="{EXECUTOR}, please listen." />
    <string id="REX_Speech2_Victim_Friendly_4" text="{EXECUTOR}, look here." />
    <string id="REX_Speech2_Victim_Hostile_1" text="{EXECUTOR}, I refuse." />
    <string id="REX_Speech2_Victim_Hostile_2" text="No praise, {EXECUTOR}." />
    <string id="REX_Speech2_Victim_Hostile_3" text="{EXECUTOR}, I object." />
    <string id="REX_Speech2_Victim_Hostile_4" text="{EXECUTOR}, remember this." />
    <string id="REX_Speech2_Crowd_Support_1" text="Let it end here." />
    <string id="REX_Speech2_Crowd_Support_2" text="The sentence has been read. Keep the way clear." />
    <string id="REX_Speech2_Crowd_Support_3" text="Carry out the sentence, then." />
    <string id="REX_Speech2_Crowd_Support_4" text="Enough. Let the sentence stand." />
    <string id="REX_Speech2_Crowd_Doubt_1" text="Is that enough to take a life?" />
    <string id="REX_Speech2_Crowd_Doubt_2" text="A charge is easy to speak." />
    <string id="REX_Speech2_Crowd_Doubt_3" text="I am not sure this is justice." />
    <string id="REX_Speech2_Crowd_Doubt_4" text="Must it end like this?" />
    <string id="REX_Speech2_Crowd_Sympathy_1" text="I would not want to stand there." />
    <string id="REX_Speech2_Crowd_Sympathy_2" text="Give the prisoner a moment." />
    <string id="REX_Speech2_Crowd_Sympathy_3" text="Keep your voice down." />
    <string id="REX_Speech2_Crowd_Sympathy_4" text="There is nothing to cheer for." />
    <string id="REX_Speech2_Crowd_Fear_1" text="I cannot bear to watch." />
    <string id="REX_Speech2_Crowd_Fear_2" text="Quiet. I do not want to see this." />
    <string id="REX_Speech2_Crowd_Fear_3" text="That is a terrible way to die." />
    <string id="REX_Speech2_Crowd_Fear_4" text="Let me stand farther back." />
    <string id="REX_Speech2_Close_Judicial_1" text="Awaiting your order." />
    <string id="REX_Speech2_Close_Judicial_2" text="The sentence is read. I await the word." />
    <string id="REX_Speech2_Close_Judicial_3" text="Ready when you give the word." />
    <string id="REX_Speech2_Close_Judicial_4" text="Give the word when you are ready." />
    <string id="REX_Speech2_Close_Spectacle_1" text="All have heard. I await your order." />
    <string id="REX_Speech2_Close_Spectacle_2" text="The sentence is proclaimed. Your order?" />
    <string id="REX_Speech2_Close_Spectacle_3" text="The proclamation is complete. I await the word." />
    <string id="REX_Speech2_Close_Spectacle_4" text="We have heard the sentence. I await your signal." />
    <string id="REX_Speech2_Close_Terror_1" text="Awaiting your command." />
    <string id="REX_Speech2_Close_Terror_2" text="The warning is given. I await your word." />
    <string id="REX_Speech2_Close_Terror_3" text="Your command will be carried out." />
    <string id="REX_Speech2_Close_Terror_4" text="Give the word." />
</strings>

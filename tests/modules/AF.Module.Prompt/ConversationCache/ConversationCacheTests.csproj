<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><NuGetAudit>false</NuGetAudit>
    <StartupObject Condition="'$(ProtocolRegression)' == 'true'">Program</StartupObject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../../src/modules/AF.Module.Prompt/Composition/PromptCacheCore/*.cs" Link="PromptCacheCore/%(Filename)%(Extension)" />

    <Compile Include="Program.cs" />
    <Compile Include="CoreFixture.cs" />
    <Compile Include="../../../../src/modules/AF.Module.Prompt/Composition/ConversationRequestBudget.cs" Link="ConversationRequestBudget.cs" />
    <Compile Include="../../../../src/modules/AF.Module.Prompt/Composition/ConversationContextWindow.cs" Link="ConversationContextWindow.cs" />
    <Compile Include="../../../../src/modules/AF.Module.Conversation/Internal/History/ConversationMessage.cs" Link="ConversationMessage.cs" />
    <Compile Include="../../AF.Module.Llm/Protocol/Program.cs" Link="ExistingProtocolRegression.cs" Condition="'$(ProtocolRegression)' == 'true'" />
    <Compile Include="../../../../src/modules/AF.Module.Llm/Protocol/LlmVisibleReplyNormalizer.cs" Link="LlmVisibleReplyNormalizer.cs" Condition="'$(ProtocolRegression)' == 'true'" />
    <Compile Include="../../../../src/modules/AF.Module.Prompt/Composition/ConversationPromptCacheStore.cs" Link="ConversationPromptCacheStore.cs" />
    <Compile Include="../../../../src/modules/AF.Module.Llm/Protocol/LlmApiCompat.cs" Link="LlmApiCompat.cs" />
    <Compile Include="../../../../src/modules/AF.Module.Llm/Protocol/PrimaryChatMessagePolicy.cs" Link="PrimaryChatMessagePolicy.cs" />
    <Compile Include="../../../../src/modules/AF.Module.Llm/Protocol/LlmSourceTexts.cs" Link="LlmSourceTexts.cs" />
    <Compile Include="../../../../src/modules/AF.Module.Llm/Application/LlmPromptTexts.cs" Link="LlmPromptTexts.cs" />
    <EmbeddedResource Include="../../../../content/modules/AF.Module.Llm/ModuleData/LlmSourceTexts.json" LogicalName="AnimusForge.Llm.RuntimeSources.json" />
    <None Include="../../../../content/modules/AF.Module.Llm/ModuleData/LlmPromptTexts.json" Link="LlmPromptTexts.json" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../../../src/modules/AF.Module.Conversation/Internal/ConversationPromptCache.cs" Link="ConversationPromptCache.cs" />
    <Compile Include="../../../../src/modules/AF.Module.Conversation/Internal/ConversationRuntimeTexts.cs" Link="ConversationRuntimeTexts.cs" />
    <Compile Include="../../../../src/modules/AF.Module.Prompt/Runtime/PromptComposerTexts.cs" Link="PromptComposerTexts.cs" />
    <None Include="../../../../content/modules/AF.Module.Conversation/ModuleData/ConversationRuntimePrompts.json" Link="ConversationRuntimePrompts.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../../../content/modules/AF.Module.Conversation/ModuleData/ConversationRuntimePrompts.en.json" Link="ConversationRuntimePrompts.en.json" CopyToOutputDirectory="PreserveNewest" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(MSBuildToolsPath)/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
</Project>

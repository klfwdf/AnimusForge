using System;
using System.Collections;
using System.Collections.Generic;
using System.Diagnostics;
using System.Linq;
using AnimusForge.Refactor.Runtime;
namespace AnimusForge;

public partial class RewardSystemBehavior
{
    private static ItemRoster NativeRoster(int count)
    {
        var roster = new ItemRoster(); var native = new ItemObject { StringId = "native" };
        for (int i = 0; i < count; i++) roster.Elements.Add(new(new(native, "slot_" + i), 1));
        return roster;
    }
    private static int DrainMarkets()
    {
        int ticks = 0;
        while (Instance.MarketCleanup.HasWork && ticks++ < 10000) Instance.OnEngineTick();
        Check(!Instance.MarketCleanup.HasWork, "world pass did not finish");
        return ticks;
    }
    private static Settlement Market(int slots, ItemObject special = null)
    {
        var market = new Settlement { StringId = "test", ItemRoster = NativeRoster(slots) };
        if (special != null) market.ItemRoster.AddToCounts(new(special, "rp"), 2);
        return market;
    }
    private static void Start(params Settlement[] markets)
    { Campaign.Current.Settlements = markets; Instance.RunDailyEntryPrefix(); }
    private static void RunMarketCleanupCases()
    {
        Case("one_complete_market_per_frame_including_large_inventory", () => {
            var special = Gift(identity: "courier_letter|session|body"); var a = Market(513, special); var b = Market(3, special);
            Start(a, b); ItemRoster.Reads = 0; Instance.OnEngineTick();
            Check(ItemRoster.Reads == 514 && a.ItemRoster.Amount(special) == 0 && b.ItemRoster.Amount(special) == 2, "frame did not process exactly one complete market");
            Instance.OnEngineTick(); Check(!Instance.MarketCleanup.HasWork && b.ItemRoster.Amount(special) == 0, "second market lost");
            Check(Logger.Messages.Count(x => x.Contains("market_sweep_completed")) == 1, "round summary missing/duplicated"); });
        Case("continuous_quantity_changes_do_not_restart_world_progress", () => {
            var special = Gift(identity: "courier_letter|session|body");
            var markets = Enumerable.Range(0, 120).Select(_ => Market(513, special)).ToArray(); Start(markets);
            ItemRoster.Reads = 0;
            for (int frame = 0; frame < 120; frame++) {
                foreach (var m in markets) m.ItemRoster.AddToCounts(m.ItemRoster.Elements[0].EquipmentElement, 1);
                Instance.OnEngineTick();
            }
            Check(!Instance.MarketCleanup.HasWork && markets.All(m => m.ItemRoster.Amount(special) == 0), "changing markets starved tail cleanup");
            Check(ItemRoster.Reads == 120 * 514, "normal quantity changes triggered duplicate scanning"); });
        Case("repeated_daily_requests_coalesce_without_restarting_current_pass", () => {
            var a = Market(3); var b = Market(4); var c = Market(5); Start(a, b, c);
            ItemRoster.Reads = 0; Instance.OnEngineTick();
            for (int i = 0; i < 1000; i++) Instance.RunDailyEntryPrefix();
            Instance.OnEngineTick(); Check(ItemRoster.Reads == 7, "daily requests restarted first market");
            Check(DrainMarkets() == 4 && ItemRoster.Reads == 24, "requests accumulated more than one repeat or lost a market"); });
        Case("snapshot_uses_live_inventory_and_additions_enter_next_pass", () => {
            var special = Gift(identity: "courier_letter|session|body"); var a = Market(1); var b = Market(1, special);
            var world = new List<Settlement> { a, b }; Campaign.Current.Settlements = world; Instance.RunDailyEntryPrefix(); Instance.OnEngineTick();
            var old = b.ItemRoster; b.ItemRoster = Market(2, special).ItemRoster;
            var c = Market(1, special); world.Add(c); Instance.OnEngineTick();
            Check(old.Amount(special) == 2 && b.ItemRoster.Amount(special) == 0 && c.ItemRoster.Amount(special) == 2, "snapshot/replacement semantics wrong");
            Instance.RunDailyEntryPrefix(); DrainMarkets(); Check(c.ItemRoster.Amount(special) == 0, "next round omitted newly added settlement"); });
        Case("trade_reference_dedup_and_permission_changes_are_rechecked", () => {
            var gift = Gift(); var market = Market(3); market.ItemRoster.AddToCounts(new(gift, "fine"), 3);
            Action close = () => { }; ItemRoster.Reads = 0;
            InventoryScreenHelperOpenScreenAsTradePrefix(market.ItemRoster, new SettlementComponent { Settlement = market }, ref close);
            Check(ItemRoster.Reads == 4 && market.ItemRoster.Amount(gift) == 3, "same reference duplicated or gift removed");
            gift.NotMerchandise = true; close();
            Check(ItemRoster.Reads == 8 && market.ItemRoster.Amount(gift) == 0, "trade close missed changed permission"); });
        Case("distinct_trade_rosters_clean_and_preserve_modifiers", () => {
            var gift = Gift(); var special = Gift(identity: "courier_letter|session|body");
            var market = Market(1, special); var left = NativeRoster(2); left.AddToCounts(new(special), 2); left.AddToCounts(new(gift, "fine"), 3);
            Action close = () => { };
            InventoryScreenHelperOpenScreenAsTradePrefix(left, new SettlementComponent { Settlement = market }, ref close);
            Check(left.Amount(special) == 0 && market.ItemRoster.Amount(special) == 0 && left.Amount(gift) == 3, "trade protection changed");
            Check(left.Elements.Any(x => x.EquipmentElement.Item == gift && x.EquipmentElement.Modifier == "fine"), "modifier changed"); });
        Case("save_and_inventory_ui_pause_only_background_pass", () => {
            var special = Gift(identity: "courier_letter|session|body"); var market = Market(1, special); Start(market);
            Campaign.Current.SaveHandler.IsSaving = true; Instance.OnEngineTick(); Check(market.ItemRoster.Count == 2, "saving mutated market");
            Campaign.Current.SaveHandler.IsSaving = false; Game.Current.GameStateManager.ActiveState = new InventoryState();
            Instance.OnEngineTick(); Check(market.ItemRoster.Count == 2 && Instance.MarketCleanup.HasWork, "inventory UI allowed background mutation");
            RemoveGeneratedRewardItemsFromRoster(market.ItemRoster, "trade", "open"); Check(market.ItemRoster.Count == 1, "trade boundary unexpectedly paused");
            Game.Current.GameStateManager.ActiveState = null; DrainMarkets(); });
        Case("generation_and_owner_changes_reject_old_world_work", () => {
            var special = Gift(identity: "courier_letter|session|body"); var market = Market(1, special); Start(market);
            SaveRuntimeGuard.AdvanceGeneration("review"); ItemRoster.Reads = 0; Instance.OnEngineTick();
            Check(!Instance.MarketCleanup.HasWork && market.ItemRoster.Count == 2 && ItemRoster.Reads == 0,
                "old generation inventory was read or modified");
            Instance.RunDailyEntryPrefix(); var old = Instance; Instance = new(); old.OnEngineTick();
            Check(market.ItemRoster.Count == 2, "old owner accepted"); old.MarketCleanup.Reset();
            Instance.RunDailyEntryPrefix(); DrainMarkets(); Check(market.ItemRoster.Count == 1, "new owner cannot start"); });
        Case("worker_cannot_admit_or_drain_world_or_trade", () => {
            var special = Gift(identity: "courier_letter|session|body"); var market = Market(1, special); Start(market);
            TWParallel.MainThread = false; Instance.OnEngineTick(); RemoveGeneratedRewardItemsFromRoster(market.ItemRoster, "test", "worker");
            Check(market.ItemRoster.Count == 2 && Instance.MarketCleanup.HasWork, "worker touched inventory");
            TWParallel.MainThread = true; DrainMarkets(); });
        Case("failed_market_is_reported_and_does_not_block_other_markets", () => {
            var special = Gift(identity: "courier_letter|session|body"); var bad = Market(1, special); var good = Market(1, special);
            bad.FailRosterRead = true; Start(bad, good); Check(DrainMarkets() == 2 && good.ItemRoster.Count == 1, "failure stranded other market");
            Check(Logger.Messages.Any(x => x.Contains("failures=1")), "failed round falsely reported clean");
            bad.FailRosterRead = false; Instance.RunDailyEntryPrefix(); DrainMarkets(); Check(bad.ItemRoster.Count == 1, "next day retry failed"); });
        Case("empty_and_failed_world_sources_do_not_spin", () => {
            Start(); Instance.OnEngineTick(); Check(!Instance.MarketCleanup.HasWork, "empty world spun");
            Instance.MarketCleanup.BeginWorldScan(() => throw new InvalidOperationException("source"), "fail");
            Instance.OnEngineTick(); Check(!Instance.MarketCleanup.HasWork, "failed source retries every frame");
            Start(Market(1)); DrainMarkets(); });
        Case("swap_last_deletion_and_reentrant_permission_or_amount_changes", () => {
            var one = Gift(identity: "courier_letter|one"); var two = Gift(identity: "courier_letter|two");
            var market = NativeRoster(2); market.AddToCounts(new(one, "a"), 1); market.AddToCounts(new(two, "b"), 7);
            ItemRoster.AfterUpdate = roster => { ItemRoster.AfterUpdate = null; roster.AddToCounts(new(two, "b"), -5); };
            int removed = RemoveGeneratedRewardItemsFromRoster(market, "test", "reentrant");
            Check(removed == 3 && market.Count == 2, "stale stack amount used after callback");
            market.AddToCounts(new(one), 1); market.AddToCounts(new(two), 1);
            ItemRoster.AfterUpdate = roster => { ItemRoster.AfterUpdate = null; Instance._generatedRewardItemRecords[two.StringId].NpcGiftMarketTradeAllowed = true; };
            RemoveGeneratedRewardItemsFromRoster(market, "test", "permission");
            Check(market.Amount(two) == 1 && market.Amount(one) == 0, "permission not rechecked before removal"); });
        Case("no_progress_and_reentrant_producer_do_not_loop", () => {
            var special = Gift(identity: "courier_letter|session|body"); var market = Market(1, special);
            market.ItemRoster.SkipRemovals = true; Start(market); DrainMarkets();
            Check(market.ItemRoster.Amount(special) == 2 && Logger.Messages.Any(x => x.Contains("failures=1")), "no-op deletion reported clean");
            market.ItemRoster.SkipRemovals = false; ItemRoster.AfterUpdate = roster => { ItemRoster.AfterUpdate = null; roster.AddToCounts(new(special, "rp"), 1); };
            RemoveGeneratedRewardItemsFromRoster(market.ItemRoster, "test", "reentrant");
            Check(market.ItemRoster.Amount(special) == 1, "cleanup unexpectedly loops over reentrant additions");
            RemoveGeneratedRewardItemsFromRoster(market.ItemRoster, "test", "next"); Check(market.ItemRoster.Count == 1, "next boundary failed"); });
        BenchmarkMarkets();
    }
    private static void BenchmarkMarkets()
    {
        // Synthetic .NET inventory; not live engine timing. Setup excluded, production owner warmed.
        Instance = new(); Campaign.Current = new(); Game.Current = new(); TWParallel.MainThread = true;
        ItemRoster.BeforeRead = ItemRoster.AfterUpdate = null; var special = Gift(identity: "courier_letter|benchmark");
        for (int i = 0; i < 30; i++) RemoveGeneratedRewardItemsFromRoster(NativeRoster(300), "warm", "bench");
        foreach (var spec in new[] { (300, 0), (5000, 0), (50000, 0), (5000, 1000) })
        {
            var times = new List<double>();
            for (int run = 0; run < 7; run++) {
                var roster = NativeRoster(spec.Item1 - spec.Item2);
                for (int i = 0; i < spec.Item2; i++) roster.Elements.Add(new(new(special, "rp_" + i), 1));
                long bytes = GC.GetAllocatedBytesForCurrentThread(); var watch = Stopwatch.StartNew();
                RemoveGeneratedRewardItemsFromRoster(roster, "bench", "measure"); watch.Stop();
                times.Add(watch.Elapsed.TotalMilliseconds);
                if (run == 6) Console.WriteLine($"BENCH slots={spec.Item1} blocked={spec.Item2} allocBytes={GC.GetAllocatedBytesForCurrentThread()-bytes}");
                Check(roster.Count == spec.Item1 - spec.Item2, "benchmark cleanup mismatch");
            }
            times.Sort(); Console.WriteLine($"BENCH slots={spec.Item1} blocked={spec.Item2} medianMs={times[3]:F3} maxMs={times[6]:F3} engine=double");
        }
    }
}

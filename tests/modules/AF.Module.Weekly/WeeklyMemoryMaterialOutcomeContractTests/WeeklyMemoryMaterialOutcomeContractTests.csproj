<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AFRepositoryRoot>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../../..'))</AFRepositoryRoot>
    <WeeklyFixtureRoot>$(AFRepositoryRoot)/artifacts/tests/weekly-outcome-project/run-$([System.Guid]::NewGuid().ToString('N'))</WeeklyFixtureRoot>
  </PropertyGroup>
  <ItemGroup>
    <WeeklySource Include="..\..\..\..\src\modules\AF.Module.Weekly\Publication\WeeklyActionOutcomePublicationOwner.cs" Link="WeeklyActionOutcomePublicationOwner.cs" />
    <WeeklySource Include="..\..\..\..\src\AF.Contracts\Internal\InteractionContracts.cs" Link="Contracts\InteractionContracts.cs" />
    <WeeklySource Include="..\..\..\..\src\AF.Contracts\Internal\LlmContracts.cs" Link="Contracts\LlmContracts.cs" />
    <WeeklySource Include="..\..\..\..\src\AF.Contracts\Compatibility\Economy\EconomyRewardDebtContracts.cs" Link="Contracts\EconomyRewardDebtContracts.cs" />
    <WeeklySource Include="..\..\..\..\src\modules\AF.Module.Weekly\Receipts\WeeklyMemoryMaterialOutcomeReceipt.cs" Link="Runtime\WeeklyMemoryMaterialOutcomeReceipt.cs" />
    <Reference Include="Newtonsoft.Json"><HintPath>$(AFRepositoryRoot)/local/dotnet/8.0.425/sdk/8.0.425/Newtonsoft.Json.dll</HintPath></Reference>
  </ItemGroup>
  <Target Name="PrepareActualWeeklyOutcomeFixture" BeforeTargets="CoreCompile">
    <Error Condition="'$(PythonExecutable)' == ''" Text="PythonExecutable must be supplied explicitly for the actual Weekly outcome fixture." />
    <Exec Command="&quot;$(PythonExecutable)&quot; -X utf8 -B &quot;$(MSBuildProjectDirectory)/run_terminal.py&quot; --prepare-only --out &quot;$(WeeklyFixtureRoot)&quot;" />
    <ItemGroup>
      <Compile Include="$(WeeklyFixtureRoot)/*.cs" />
    </ItemGroup>
  </Target>
</Project>

public struct Vec2 {
 public float x,y; public float LengthSquared=>x*x+y*y; public float RotationInRadians=>0;
 public void Normalize(){float l=(float)Math.Sqrt(LengthSquared);if(l>0){x/=l;y/=l;}}
 public float DistanceSquared(Vec2 v)=>(x-v.x)*(x-v.x)+(y-v.y)*(y-v.y);
 public static float DotProduct(Vec2 a,Vec2 b)=>a.x*b.x+a.y*b.y;
 public static Vec2 operator -(Vec2 a,Vec2 b)=>new Vec2{x=a.x-b.x,y=a.y-b.y};
}
public struct Vec3 {
 public float x,y,z; public Vec2 AsVec2=>new Vec2{x=x,y=y};
 public float DistanceSquared(Vec3 v)=>AsVec2.DistanceSquared(v.AsVec2)+(z-v.z)*(z-v.z);
}

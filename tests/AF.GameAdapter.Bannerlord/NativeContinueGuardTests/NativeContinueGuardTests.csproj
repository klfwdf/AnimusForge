<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net472</TargetFramework><LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget><NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../../src/AF.GameAdapter.Bannerlord/Patches/Safety/ContinueConversationSafePatch.cs" Link="Production/ContinueConversationSafePatch.cs" />
    <Compile Include="../../../src/AF.GameAdapter.Bannerlord/UI/Conversation/AnimusForgeNativeConversationOverlay.ContinueGuard.cs" Link="Production/ContinueGuard.cs" />
    <Compile Include="../../../src/AF.Foundation.Runtime/Lifecycle/SaveRuntimeGuard.cs" Link="Production/SaveRuntimeGuard.cs" />
    <Reference Include="$(GuardReferenceDir)/TaleWorlds.*.dll"><Private>true</Private></Reference>
    <Reference Include="TaleWorlds.SaveSystem"><HintPath>$(GuardSharedReferenceDir)/TaleWorlds.SaveSystem.dll</HintPath></Reference>
    <Reference Include="0Harmony"><HintPath>$(GuardHarmonyDir)/0Harmony.dll</HintPath></Reference>
    <None Include="$(GuardHarmonyDir)/0Harmony.dll;$(GuardHarmonyDir)/MonoMod*.dll;$(GuardHarmonyDir)/Mono.Cecil*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="RequireInputs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GuardReferenceDir)/TaleWorlds.CampaignSystem.dll') Or !Exists('$(GuardHarmonyDir)/0Harmony.dll')" Text="Explicit native reference and Harmony directories required." />
  </Target>
</Project>

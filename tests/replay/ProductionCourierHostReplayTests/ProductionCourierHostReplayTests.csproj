<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <Import Project="..\ReplayDependencies\BannerlordReplayDependencies.targets" />
  <PropertyGroup>
    <_ReplayImplementationPath Condition="'$(ReplayCandidateDll)' != ''">$(ReplayCandidateDll)</_ReplayImplementationPath>
  </PropertyGroup>
  <Target Name="RequireCourierCandidate" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(ReplayCandidateDll)' == ''" Text="Courier replay requires explicit -p:ReplayCandidateDll from the current single_module_artifacts build." />
  </Target>
</Project>

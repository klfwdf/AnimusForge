<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <!-- Compile and runtime must use the same pinned game-reference authority.
         Replay dependency copying rejects mismatched assemblies rather than overwriting them. -->
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(Bannerlord14ReferencePath)/Newtonsoft.Json.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\ReplayDependencies\ReplayCandidateInput.cs" Link="ReplayCandidateInput.cs" />
  </ItemGroup>
  <Import Project="..\ReplayDependencies\BannerlordReplayDependencies.targets" />
</Project>

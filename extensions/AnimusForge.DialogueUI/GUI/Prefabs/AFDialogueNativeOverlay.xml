<Prefab>
  <Window>
    <Widget Id="AFDialogueNativeOverlay" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true" DoNotPassEventsToChildren="false">
      <Children>
        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="341"
            VerticalAlignment="Bottom" MarginLeft="0" MarginRight="0" MarginBottom="0"
            DoNotAcceptEvents="true" DoNotPassEventsToChildren="false">
          <Children>
            <Widget Id="AFDialogueRightColumn" WidthSizePolicy="Fixed" SuggestedWidth="466" HeightSizePolicy="Fixed" SuggestedHeight="276"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="57" MarginBottom="27"
                DoNotAcceptEvents="true" DoNotPassEventsToChildren="false">
              <Children>
                <ListPanel Id="AFDialogueToolbar" WidthSizePolicy="Fixed" SuggestedWidth="403" HeightSizePolicy="Fixed" SuggestedHeight="34"
                    HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="30" MarginTop="0" StackLayout.LayoutMethod="HorizontalLeftToRight"
                    DoNotAcceptEvents="true" DoNotPassEventsToChildren="false">
                  <Children>
                    <ButtonWidget Id="AFDialogueHistory" WidthSizePolicy="Fixed" SuggestedWidth="73" HeightSizePolicy="Fixed" SuggestedHeight="30" Command.Click="ShowLogView" Brush="Popup.Done.Button.NineGrid" DoNotPassEventsToChildren="true">
                      <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="对话历史" Brush="Popup.Button.Text" Brush.FontSize="13" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                    </ButtonWidget>
                    <ButtonWidget Id="AFDialogueGift" WidthSizePolicy="Fixed" SuggestedWidth="79" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginLeft="5" Command.Click="ShowGiveShowMenu" Brush="Popup.Done.Button.NineGrid" DoNotPassEventsToChildren="true">
                      <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="给予/展示" Brush="Popup.Button.Text" Brush.FontSize="13" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                    </ButtonWidget>
                    <ButtonWidget Id="AnimusForgeConversationIllustrateButton" WidthSizePolicy="Fixed" SuggestedWidth="73" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginLeft="5" Command.Click="ShowIllustration" IsVisible="@IsIllustrationAvailable" Brush="Popup.Done.Button.NineGrid" DoNotPassEventsToChildren="true">
                      <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="场景插画" Brush="Popup.Button.Text" Brush.FontSize="13" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                    </ButtonWidget>
                    <ButtonWidget Id="AFDialogueSwitch" WidthSizePolicy="Fixed" SuggestedWidth="79" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginLeft="5" Command.Click="SwitchTalk" IsEnabled="@IsInteractionEnabled" Brush="Popup.Done.Button.NineGrid" DoNotPassEventsToChildren="true">
                      <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="@SwitchTitle" Brush="Popup.Button.Text" Brush.FontSize="13" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                    </ButtonWidget>
                    <ButtonWidget Id="AFDialogueLeave" WidthSizePolicy="Fixed" SuggestedWidth="52" HeightSizePolicy="Fixed" SuggestedHeight="30" MarginLeft="5" Command.Click="LeaveConversation" IsEnabled="@CanLeave" Brush="Popup.Done.Button.NineGrid" DoNotPassEventsToChildren="true">
                      <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="离开" Brush="Popup.Button.Text" Brush.FontSize="13" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>

                <Widget Id="AFDialogueInput" WidthSizePolicy="Fixed" SuggestedWidth="403" HeightSizePolicy="Fixed" SuggestedHeight="226"
                    HorizontalAlignment="Right" VerticalAlignment="Top" MarginRight="30" MarginTop="24"
                    IsVisible="@IsCustomAnswerVisible" DoNotPassEventsToChildren="false">
                  <Children>
                    <DevMultilineEditableTextWidget MarginLeft="12" MarginRight="52" MarginTop="10" MarginBottom="10"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" VerticalAlignment="Top" Command.TextEntered="ExecuteSubmit"
                        Command.FocusGained="StartTyping" Command.FocusLost="StopTyping" Brush="ConversationItem.Text" Brush.FontSize="17"
                        Brush.FontColor="#382919FF" Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Top" EditorFontSize="17"
                        RealText="@InputText" AutoFocus="true" SubmitOnEnter="true" UseBlackCaret="true"
                        MaxLength="6000" IsEnabled="@IsInputEnabled" />
                    <ButtonWidget Id="AFDialogueSubmit" WidthSizePolicy="Fixed" SuggestedWidth="44" HeightSizePolicy="Fixed" SuggestedHeight="38"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="6" MarginBottom="6" Command.Click="ExecuteSubmit"
                        IsEnabled="@IsInputEnabled" Brush="Popup.Done.Button.NineGrid" DoNotPassEventsToChildren="true">
                      <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="发送" Brush="Popup.Button.Text" Brush.FontSize="13" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                    </ButtonWidget>
                  </Children>
                </Widget>
              </Children>
            </Widget>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>

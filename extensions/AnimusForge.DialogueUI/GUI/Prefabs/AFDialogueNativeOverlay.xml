<Prefab>
  <Window>
    <Widget Id="AFDialogueNativeOverlay" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" DoNotAcceptEvents="true" DoNotPassEventsToChildren="false">
      <Children>
        <!-- Overlay follows the current Pen layout: 1440x283 centered, floating 43px above the bottom edge. -->
        <Widget Id="AFDialogueConsoleOverlayFrame" WidthSizePolicy="Fixed" SuggestedWidth="1440" HeightSizePolicy="Fixed" SuggestedHeight="283"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="43"
            DoNotAcceptEvents="true" DoNotPassEventsToChildren="false">
          <Children>
            <Widget Id="AFDialogueRightColumn" WidthSizePolicy="Fixed" SuggestedWidth="305" HeightSizePolicy="Fixed" SuggestedHeight="217"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="21" MarginBottom="20"
                DoNotAcceptEvents="true" DoNotPassEventsToChildren="false">
              <Children>
                <ListPanel Id="AFDialogueToolbar" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" MarginTop="0" StackLayout.LayoutMethod="HorizontalLeftToRight"
                    DoNotAcceptEvents="true" DoNotPassEventsToChildren="false">
                  <Children>
                    <ButtonWidget Id="AFDialogueHistory" WidthSizePolicy="Fixed" SuggestedWidth="63" HeightSizePolicy="Fixed" SuggestedHeight="28" Command.Click="ShowLogView" DoNotPassEventsToChildren="true">
                      <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="对话历史" Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#3B281BFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                    </ButtonWidget>
                    <ButtonWidget Id="AFDialogueGift" WidthSizePolicy="Fixed" SuggestedWidth="69" HeightSizePolicy="Fixed" SuggestedHeight="28" MarginLeft="2" Command.Click="ShowGiveShowMenu" DoNotPassEventsToChildren="true">
                      <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="给予/展示" Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#3B281BFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                    </ButtonWidget>
                    <ButtonWidget Id="AnimusForgeConversationIllustrateButton" WidthSizePolicy="Fixed" SuggestedWidth="63" HeightSizePolicy="Fixed" SuggestedHeight="28" MarginLeft="2" Command.Click="ShowIllustration" IsVisible="@IsIllustrationAvailable" DoNotPassEventsToChildren="true">
                      <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="场景插画" Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#3B281BFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                    </ButtonWidget>
                    <ButtonWidget Id="AFDialogueSwitch" WidthSizePolicy="Fixed" SuggestedWidth="63" HeightSizePolicy="Fixed" SuggestedHeight="28" MarginLeft="2" Command.Click="SwitchTalk" IsEnabled="@IsInteractionEnabled" DoNotPassEventsToChildren="true">
                      <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="@SwitchTitle" Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#3B281BFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                    </ButtonWidget>
                    <ButtonWidget Id="AFDialogueLeave" WidthSizePolicy="Fixed" SuggestedWidth="39" HeightSizePolicy="Fixed" SuggestedHeight="28" MarginLeft="2" Command.Click="LeaveConversation" IsEnabled="@CanLeave" DoNotPassEventsToChildren="true">
                      <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Text="离开" Brush="Popup.Button.Text" Brush.FontSize="15" Brush.FontColor="#3B281BFF" Brush.TextHorizontalAlignment="Center" Brush.TextVerticalAlignment="Center" DoNotAcceptEvents="true" /></Children>
                    </ButtonWidget>
                  </Children>
                </ListPanel>

                <Widget Id="AFDialogueInput" WidthSizePolicy="Fixed" SuggestedWidth="305" HeightSizePolicy="Fixed" SuggestedHeight="188"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginBottom="0"
                    IsVisible="@IsCustomAnswerVisible" DoNotPassEventsToChildren="false">
                  <Children>
                    <DevMultilineEditableTextWidget MarginLeft="3" MarginRight="3" MarginTop="9" MarginBottom="9"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" VerticalAlignment="Top" Command.TextEntered="ExecuteSubmit"
                        Command.FocusGained="StartTyping" Command.FocusLost="StopTyping" Brush="ConversationItem.Text" Brush.FontSize="16"
                        Brush.FontColor="#3B281BFF" Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Top" EditorFontSize="16"
                        RealText="@InputText" AutoFocus="true" SubmitOnEnter="true" UseBlackCaret="true"
                        MaxLength="6000" IsEnabled="@IsInputEnabled" />
                    <TextWidget Id="AFDialogueInputPlaceholder" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        MarginLeft="3" MarginRight="3" MarginTop="9" MarginBottom="9" Text="输入你要说的话……&#10;Enter 发送 · Shift+Enter 换行"
                        Brush="ConversationItem.Text" Brush.FontSize="16" Brush.FontColor="#6B4A28B8"
                        Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Top" IsVisible="@IsInputEmpty" DoNotAcceptEvents="true" />
                  </Children>
                </Widget>
          </Children>
        </Widget>
      </Children>
    </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>

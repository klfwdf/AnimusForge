<Prefab>
  <Window>
    <!--
      This is a replacement presentation for the native SPConversation movie.
      It owns a new widget tree, but keeps the MissionConversationVM contract:
      AnswerList/ConversationItem, ExecuteContinue, persuasion, encyclopedia,
      and the native option disabled/tooltip state all remain data-bound.
    -->
    <ConversationScreenButtonWidget Id="AFDialogueConversationRoot"
        DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
        AnswerList="AFDialogueConsoleFrame\VerticalContainer\BottomPanelsContainer\AnswerListContainer\AFDialogueAnswerScroll\AFDialogueAnswerClip\AnswerList"
        ContinueButton="ContinueButton" Command.OnFinalSelection="ExecuteFinalizeSelection"
        IsPersuasionActive="@IsPersuading" FrictionEnabled="false">
      <Children>
        <NavigationScopeTargeter ScopeID="SPConversationClickToContinueButtonScope" ScopeParent="..\ContinueButton" IsDefaultNavigationScope="true" />
        <ButtonWidget Id="ContinueButton" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsDisabled="true" IsVisible="false" Command.Click="ExecuteContinue">
          <Children>
            <!-- Label must not take the press: native wraps it in a DoNotAcceptEvents widget. Accepting it made
                 clicks inside the right frame land on the text instead of ContinueButton. -->
            <RichTextWidget WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                MarginRight="265" MarginBottom="51" Brush="Conversation.HeaderText" Brush.FontSize="26" Text="@ContinueText"
                DoNotAcceptEvents="true" GamepadNavigationIndex="0" />
          </Children>
        </ButtonWidget>

        <!-- Generated artwork is a background only. Main container follows the current Pen layout: 1619x326 at Pen x=138/y=754 on the 1920x1080 reference canvas. -->
        <Widget Id="AFDialogueConsoleFrame" WidthSizePolicy="Fixed" SuggestedWidth="1619" HeightSizePolicy="Fixed" SuggestedHeight="326"
            HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="0" DoNotAcceptEvents="true" DoNotPassEventsToChildren="false" PositionXOffset="-12.5">
          <Children>
            <!-- Fitted to the artwork's oval opening, with overlap UNDER the gold rim. -->
            <Widget Id="AFDialoguePortraitBackground" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="190" SuggestedHeight="195" HorizontalAlignment="Left" VerticalAlignment="Top"
                MarginLeft="139.414" MarginTop="52.239" Sprite="afdui_portrait_background"
                DoNotAcceptEvents="true" DoNotPassEventsToChildren="true" />
            <!-- Native 3D speaker tableau is inserted here by NativeSession. -->
            <Widget Id="AFDialoguePortraitSlot" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="190" SuggestedHeight="244"
                HorizontalAlignment="Left" VerticalAlignment="Bottom" MarginLeft="139" MarginBottom="32" ClipContents="true" DoNotAcceptEvents="true">
              <Children>
                <!-- Overscan beneath the foreground gold rim; preserve the aperture center. -->
                <Widget Id="AFDialoguePortraitViewport" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="190" SuggestedHeight="195"
                    HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="2" CircularClipEnabled="true" CircularClipRadius="100"
                    CircularClipSmoothingRadius="1" DoNotAcceptEvents="true">
                  <Children>
                    <CharacterTableauWidget Id="AFDialogueLiveSpeakerPortrait" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                        SuggestedWidth="570" SuggestedHeight="726" HorizontalAlignment="Left" VerticalAlignment="Top" PositionXOffset="-190" PositionYOffset="-154"
                        StanceIndex="1" CustomRenderScale="1.35" IsVisible="false" DoNotAcceptEvents="true" />
                  </Children>
                </Widget>
                <!-- A narrow wood nameplate sits above the lower frame edge and masks the tableau torso. -->
                <Widget Id="AFDialoguePortraitBottomMask" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="190" SuggestedHeight="26"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Sprite="afdui_nameplate" DoNotAcceptEvents="true" />
              </Children>
            </Widget>

            <!-- Artwork masks the overscanned shoulders instead of the circle cutting them short. -->
            <Widget Id="AFDialogueBackdrop" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                Sprite="afdui_console_base_option_02_walnut_original_ratio" DoNotAcceptEvents="true" />

            <ListPanel Id="VerticalContainer" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                StackLayout.LayoutMethod="VerticalBottomToTop" HorizontalAlignment="Center" VerticalAlignment="Bottom" DoNotAcceptEvents="true">
              <Children>
                <Widget Id="BottomPanelsContainer" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="214"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="42" DoNotAcceptEvents="true">
                  <Children>
                    <!-- Central text sheet follows the Pen frame: 718x214 at the widened center panel. -->
                    <Widget Id="DialogueContainer" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="718" SuggestedHeight="214"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom" MarginLeft="472" MarginBottom="2" DoNotAcceptEvents="true">
                      <Children>
                        <Widget Id="AFDialogueTextPanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            DoNotAcceptEvents="true">
                          <Children>
                            <AFDialogueClickThroughScrollPanel Id="AFDialogueTextScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                                MarginLeft="14" MarginRight="38" MarginTop="8" MarginBottom="10" ClipRect="AFDialogueTextClip"
                                InnerPanel="AFDialogueTextClip\AFDialogueTextContent" AutoHideScrollBars="true" VerticalScrollbar="..\AFDialogueTextScrollbar" MouseScrollAxis="Vertical" UpdateScrollbarVisibility="true" AutoAdjustScrollbarHandleSize="true">
                              <Children>
                                <Widget Id="AFDialogueTextClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true" DoNotAcceptEvents="true">
                                  <Children>
                                    <Widget Id="AFDialogueTextContent" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" DoNotAcceptEvents="true">
                                      <Children>
                                        <AFDialogueBodyRichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Top"
                                            Brush="Conversation.ConversedPartyLine.Text" Brush.FontSize="24" Brush.FontColor="#3B281BFF"
                                            Command.LinkAlternateClick="ExecuteLink" Command.LinkClick="ExecuteLink"
                                            Text="@DialogText" />
                                      </Children>
                                    </Widget>
                                  </Children>
                                </Widget>
                              </Children>
                            </AFDialogueClickThroughScrollPanel>
                            <ScrollbarWidget Id="AFDialogueTextScrollbar" WidthSizePolicy="Fixed" SuggestedWidth="6" HeightSizePolicy="StretchToParent"
                                HorizontalAlignment="Right" MarginRight="14" MarginTop="10" MarginBottom="10" AlignmentAxis="Vertical"
                                Handle="AFDialogueTextHandle" MinValue="0" MaxValue="100" IsVisible="false">
                              <Children><Widget Id="AFDialogueTextHandle" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" Sprite="afdui_scroll_handle" /></Children>
                            </ScrollbarWidget>
                          </Children>
                        </Widget>
                      </Children>
                    </Widget>
                    <NavigationScopeTargeter ScopeID="SPConversationItemsScope" ScopeParent="..\AnswerListContainer"
                        ScopeMovements="Vertical" HasCircularMovement="true" IsDefaultNavigationScope="true" />
                    <!-- A bounded scroll viewport stays inside the 326px event ancestry. Long text
                         wraps to the answer panel; overflowing options are reached by scrolling. -->
                    <Widget Id="AnswerListContainer" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="345" SuggestedHeight="211"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginRight="36" DoNotAcceptEvents="true">
                      <Children>
                        <AFDialogueClickThroughScrollPanel Id="AFDialogueAnswerScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                            MarginRight="0" ClipRect="AFDialogueAnswerClip" InnerPanel="AFDialogueAnswerClip\AnswerList"
                            VerticalScrollbar="..\AFDialogueAnswerScrollbar" AutoHideScrollBars="true" MouseScrollAxis="Vertical" UpdateScrollbarVisibility="true" AutoAdjustScrollbarHandleSize="true">
                          <Children>
                            <Widget Id="AFDialogueAnswerClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true" DoNotAcceptEvents="true">
                              <Children>
                                <NavigatableListPanel Id="AnswerList" DataSource="{AnswerList}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                                    HorizontalAlignment="Center" VerticalAlignment="Top" StackLayout.LayoutMethod="VerticalTopToBottom" DoNotAcceptEvents="true">
                                  <ItemTemplate><AFDialogueConversationItem /></ItemTemplate>
                                </NavigatableListPanel>
                              </Children>
                            </Widget>
                          </Children>
                        </AFDialogueClickThroughScrollPanel>
                        <ScrollbarWidget Id="AFDialogueAnswerScrollbar" WidthSizePolicy="Fixed" SuggestedWidth="6" HeightSizePolicy="StretchToParent"
                            HorizontalAlignment="Right" AlignmentAxis="Vertical" Handle="AFDialogueAnswerHandle" MinValue="0" MaxValue="100" MarginRight="10" IsVisible="false">
                          <Children><Widget Id="AFDialogueAnswerHandle" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="26" Sprite="afdui_scroll_handle" /></Children>
                        </ScrollbarWidget>
                      </Children>
                    </Widget>
                  </Children>
                </Widget>
                <ListPanel Id="PersuationExtensionListPanel" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" DoNotAcceptEvents="true">
                  <Children>
                    <Widget Id="PersuationExtensionParent" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren"
                        IsVisible="@IsPersuading" DoNotAcceptEvents="true">
                      <Children>
                        <Widget Id="PersuationExtension" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="@IsPersuading" DoNotAcceptEvents="true">
                          <Children>
                            <Widget DataSource="{Persuasion}" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                              <Children>
                                <ListPanel DataSource="{PersuasionProgress}" Id="ProgressClipWidget" WidthSizePolicy="CoverChildren" HeightSizePolicy="CoverChildren">
                                  <ItemTemplate>
                                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="22" SuggestedHeight="22" MarginLeft="5" MarginRight="5">
                                      <Children>
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="afdui_persuasion_dot" IsVisible="@IsActive" />
                                      </Children>
                                    </Widget>
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </Widget>
                          </Children>
                        </Widget>
                      </Children>
                    </Widget>
                  </Children>
                </ListPanel>
              </Children>
            </ListPanel>

            <Widget Id="AFDialogueSpeakerInfo" DoNotAcceptEvents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed"
                SuggestedWidth="252" SuggestedHeight="37" VerticalAlignment="Bottom" HorizontalAlignment="Left" MarginLeft="112.431" MarginBottom="35.691">
              <Children>
                <Widget Id="CharacterNameContainer" DoNotAcceptEvents="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                    VerticalAlignment="Center" Sprite="afdui_nameplate">
                  <Children>
                    <ButtonWidget Id="CharacterNameIdParent" DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Command.AlternateClick="ExecuteConversedHeroLink" Command.Click="ExecuteConversedHeroLink"
                        Command.HoverBegin="ExecuteHeroTooltip" Command.HoverEnd="ExecuteCloseTooltip" UpdateChildrenStates="true"
                        IsEnabled="@IsCurrentCharacterValidInEncyclopedia">
                      <Children>
                        <TextWidget WidthSizePolicy="StretchToParent" DoNotAcceptEvents="true" HeightSizePolicy="StretchToParent"
                            MarginLeft="35" MarginRight="6" Brush="Conversation.HeaderText" Brush.FontSize="20" Brush.FontColor="#D7A343FF"
                            Brush.TextHorizontalAlignment="Left" Brush.TextVerticalAlignment="Center"
                            Text="@CurrentCharacterNameLbl" HoveredCursorState="RightClickLink" ExtendCursorAreaTop="-20" ExtendCursorAreaBottom="-20" GamepadNavigationIndex="0" />
                      </Children>
                    </ButtonWidget>
                  </Children>
                </Widget>
                <Widget Id="ConversedHeroBannerHost" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="24" SuggestedHeight="24"
                    HorizontalAlignment="Left" PositionXOffset="6" VerticalAlignment="Center" IsVisible="@IsBannerEnabled" DoNotAcceptEvents="true">
                  <Children>
                    <ImageIdentifierWidget Id="ConversedHeroBanner" DoNotAcceptEvents="true" DataSource="{ConversedHeroBanner}"
                        WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MarginLeft="4" MarginRight="4" MarginTop="4" MarginBottom="4" AdditionalArgs="@AdditionalArgs" HideWhenNull="true"
                        ImageId="@Id" TextureProviderName="@TextureProviderName" />
                    <HintWidget DataSource="{FactionHint}" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent"
                        Command.HoverBegin="ExecuteBeginHint" Command.HoverEnd="ExecuteEndHint" />
                  </Children>
                </Widget>
              </Children>
            </Widget>
          </Children>
        </Widget>
      </Children>
    </ConversationScreenButtonWidget>
  </Window>
</Prefab>

<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net472</TargetFramework><LangVersion>10.0</LangVersion><EnableDefaultCompileItems>false</EnableDefaultCompileItems></PropertyGroup>
 <ItemGroup>
  <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
  <Reference Include="0Harmony"><HintPath>$(HarmonyPath)</HintPath></Reference>
  <Compile Include="Program.cs" />
 </ItemGroup>
 <Target Name="CheckHarmony" BeforeTargets="PrepareForBuild"><Error Condition="'$(HarmonyPath)' == '' Or !Exists('$(HarmonyPath)')" Text="Pass the real HarmonyPath." /></Target>
</Project>

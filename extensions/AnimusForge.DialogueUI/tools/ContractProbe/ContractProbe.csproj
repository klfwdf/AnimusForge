<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>AnimusForge.DialogueUI.ContractProbe</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>../../artifacts/contract-probe/</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="0Harmony"><HintPath>$(GameRoot)/Modules/Bannerlord.Harmony/bin/Win64_Shipping_Client/0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="TaleWorlds.Library"><HintPath>$(GameRoot)/bin/Win64_Shipping_Client/TaleWorlds.Library.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="AnimusForge"><HintPath>$(AfReferencePath)</HintPath><Private>false</Private></Reference>
    <Reference Include="AnimusForge.DialogueUI"><HintPath>$(DialogueUiPath)</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="RequireActualBinaries" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(AfReferencePath)') or !Exists('$(DialogueUiPath)')" Text="Pass AfReferencePath and DialogueUiPath for the actual binaries under test." />
    <Error Condition="!Exists('$(GameRoot)/bin/Win64_Shipping_Client/TaleWorlds.Library.dll')" Text="Pass GameRoot containing executable TaleWorlds assemblies." />
  </Target>
</Project>

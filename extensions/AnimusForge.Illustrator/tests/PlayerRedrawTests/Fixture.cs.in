    using Newtonsoft.Json.Linq;
    public class IllustrationOptions { public bool EnableLlmPromptExpansion = true; public string DirectorApiBaseUrl = "offline"; }
    public class GenerationDiagnostics { public static GenerationDiagnostics Current; public void RecordStage(string stage, JObject details) { } }
    public static class VisualDirectorEngine { __DIRECTOR_GUARD__ }

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Deterministic>true</Deterministic>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyName>AnimusForge.Illustrator</AssemblyName>
    <RootNamespace>AnimusForge.Illustrator</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\Win64_Shipping_Client\</OutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);bin\**;obj\**;..\bin\**;..\obj\**</DefaultItemExcludes>
    <BannerlordApi Condition="'$(BannerlordApi)' == ''">1.4</BannerlordApi>
    <BannerlordReferenceVersion>1.3.15.110062</BannerlordReferenceVersion>
    <BannerlordGamePath Condition="'$(BannerlordGamePath)' == ''">F:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordGamePath>
    <RepoBinPath>$(MSBuildThisFileDirectory)..\..\..\bin\Debug\net472</RepoBinPath>
    <AnimusForgeArtifactsPath>$(MSBuildThisFileDirectory)..\..\..\bin\$(Configuration)\single_module_artifacts\versions</AnimusForgeArtifactsPath>
    <AnimusForgeAssemblyPath Condition="'$(BannerlordApi)' == '1.3' and Exists('$(AnimusForgeArtifactsPath)\1.3\AnimusForge.dll')">$(AnimusForgeArtifactsPath)\1.3\AnimusForge.dll</AnimusForgeAssemblyPath>
    <AnimusForgeAssemblyPath Condition="'$(BannerlordApi)' == '1.4' and Exists('$(AnimusForgeArtifactsPath)\1.4\AnimusForge.dll')">$(AnimusForgeArtifactsPath)\1.4\AnimusForge.dll</AnimusForgeAssemblyPath>
    <AnimusForgeAssemblyPath Condition="'$(AnimusForgeAssemblyPath)' == '' and Exists('$(BannerlordGamePath)\Modules\AnimusForge\bin\Win64_Shipping_Client\AnimusForge.dll')">$(BannerlordGamePath)\Modules\AnimusForge\bin\Win64_Shipping_Client\AnimusForge.dll</AnimusForgeAssemblyPath>
    <AnimusForgeAssemblyPath Condition="'$(AnimusForgeAssemblyPath)' == ''">$(RepoBinPath)\AnimusForge.dll</AnimusForgeAssemblyPath>
    <BannerlordCoreRefPath Condition="'$(BannerlordApi)' == '1.3'">$(NuGetPackageRoot)bannerlord.referenceassemblies.core\$(BannerlordReferenceVersion)\ref\net472\</BannerlordCoreRefPath>
    <BannerlordCoreRefPath Condition="'$(BannerlordApi)' != '1.3'">$(BannerlordGamePath)\bin\Win64_Shipping_Client\</BannerlordCoreRefPath>
    <BannerlordNativeRefPath Condition="'$(BannerlordApi)' == '1.3'">$(NuGetPackageRoot)bannerlord.referenceassemblies.native\$(BannerlordReferenceVersion)\ref\net472\</BannerlordNativeRefPath>
    <BannerlordNativeRefPath Condition="'$(BannerlordApi)' != '1.3'">$(BannerlordGamePath)\bin\Win64_Shipping_Client\</BannerlordNativeRefPath>
    <BannerlordSandboxRefPath Condition="'$(BannerlordApi)' == '1.3'">$(NuGetPackageRoot)bannerlord.referenceassemblies.sandbox\$(BannerlordReferenceVersion)\ref\net472\</BannerlordSandboxRefPath>
    <BannerlordSandboxRefPath Condition="'$(BannerlordApi)' != '1.3'">$(BannerlordGamePath)\Modules\SandBox\bin\Win64_Shipping_Client\</BannerlordSandboxRefPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BannerlordApi)' == '1.4'">
    <DefineConstants>$(DefineConstants);BANNERLORD_1_4_OR_GREATER</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net472" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Bannerlord.ReferenceAssemblies" Version="$(BannerlordReferenceVersion)" PrivateAssets="all" Condition="'$(BannerlordApi)' == '1.3'" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Numerics.Vectors">

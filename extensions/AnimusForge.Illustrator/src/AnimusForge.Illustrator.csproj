      <HintPath Condition="!Exists('$(BannerlordGamePath)\bin\Win64_Shipping_Client\System.Numerics.Vectors.dll')">$(RepoBinPath)\System.Numerics.Vectors.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">

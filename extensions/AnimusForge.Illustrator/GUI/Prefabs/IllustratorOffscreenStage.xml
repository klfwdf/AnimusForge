<Prefab>
  <!-- 离屏渲染舞台：透明控件保持在可渲染区域，由游戏自身 UI 管线创建并 tick 其 TableauView，
       运行时只需在 TableauView 上设置落盘标志即可安全取图。IsVisible=false 会阻止 provider tick。 -->
  <Window>
    <Children>
      <BannerTableauWidget Id="OffscreenBanner" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="512" SuggestedHeight="512" PositionXOffset="0" PositionYOffset="0" AlphaFactor="0" IsNineGrid="true" IsVisible="false" DoNotAcceptEvents="true" />
      <CharacterTableauWidget Id="OffscreenCharacter" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="384" SuggestedHeight="768" PositionXOffset="0" PositionYOffset="0" AlphaFactor="0" IsVisible="false" DoNotAcceptEvents="true" />
    </Children>
  </Window>
</Prefab>

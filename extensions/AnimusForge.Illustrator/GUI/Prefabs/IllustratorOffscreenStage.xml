<Prefab>
  <!-- Offscreen rendering stage: Gauntlet uses only the first child of Window as the root template, so wrap it in one root Widget.
       The root fills the screen without a texture and draws no pixels.
       To hide it from the player, wrap the tableau in a 2x2 ClipContents container.
       Render-time scissoring leaves child layout and provider ticks intact; TableauView still renders
       full-size captures to disk (full body 384x768; native EmphasizeFace head-and-shoulders 768x768),
       while the screen blit is clipped to 2x2 pixels. AlphaFactor=0 and lowest layer priority (1) are extra safeguards.
       IsVisible=false stops provider ticks, so keep IsVisible=true and enable the widget from code when needed. -->
  <Window>
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" IsVisible="true" DoNotAcceptEvents="true">
      <Children>
        <Widget ClipContents="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="2" SuggestedHeight="2" HorizontalAlignment="Left" VerticalAlignment="Top" DoNotAcceptEvents="true">
          <Children>
            <CharacterTableauWidget Id="OffscreenCharacter" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="384" SuggestedHeight="768" HorizontalAlignment="Left" VerticalAlignment="Top" AlphaFactor="0" IsVisible="false" DoNotAcceptEvents="true" />
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>

<Prefab>
  <Window>
    <!-- Full-screen translucent overlay -->
    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#88000000">
      <Children>
        <!-- Draggable main popup -->
        <Widget Id="MainPanel" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="1360" SuggestedHeight="860" HorizontalAlignment="Center" VerticalAlignment="Center" DoNotAcceptEvents="false" DoNotPassEventsToChildren="false">
          <Children>
            <!-- Canvas background and frame -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas" DoNotAcceptEvents="true" />
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="StdAssets\Popup\canvas_gradient" IsEnabled="false" DoNotAcceptEvents="true" />
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="16" ExtendTop="16" ExtendRight="16" ExtendBottom="16" IsEnabled="false" DoNotAcceptEvents="true" />

            <!-- Title bar and drag handle -->
            <Widget Id="TitleBar" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="72" VerticalAlignment="Top" MarginLeft="20" MarginRight="20" MarginTop="16" DoNotAcceptEvents="false">
              <Children>
                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Center" Brush="Popup.Title.Text" Brush.FontSize="32" Brush.TextHorizontalAlignment="Center" Text="@GalleryTitleText" DoNotAcceptEvents="true" />
              </Children>
            </Widget>

            <!-- Main content: two columns -->
            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" VerticalAlignment="Top" MarginTop="96" MarginBottom="76" MarginLeft="24" MarginRight="24">
              <Children>
                <ListPanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" LayoutImp.LayoutMethod="HorizontalLeftToRight">
                  <Children>
                    <!-- Leftmost tabs: all / favorites -->
                    <ListPanel WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="110" MarginRight="12" LayoutImp.LayoutMethod="VerticalTopToBottom">
                      <Children>
                        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56" MarginBottom="8" Brush="Popup.Cancel.Button" Command.Click="ExecuteShowAll" IsSelected="@IsAllTab" UpdateChildrenStates="true">
                          <Children>
                            <Widget IsVisible="@IsAllTab" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4" HorizontalAlignment="Left" MarginTop="6" MarginBottom="6" Sprite="BlankWhiteSquare_9" Color="#DDBB73FF" DoNotAcceptEvents="true" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" VerticalAlignment="Center" Brush="Popup.Button.Text" Brush.FontSize="18" Text="@AllText" DoNotAcceptEvents="true" />
                          </Children>
                        </ButtonWidget>
                        <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="56" Brush="Popup.Cancel.Button" Command.Click="ExecuteShowFavorites" IsSelected="@IsFavoritesTab" UpdateChildrenStates="true">
                          <Children>
                            <Widget IsVisible="@IsFavoritesTab" WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4" HorizontalAlignment="Left" MarginTop="6" MarginBottom="6" Sprite="BlankWhiteSquare_9" Color="#DDBB73FF" DoNotAcceptEvents="true" />
                            <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" VerticalAlignment="Center" Brush="Popup.Button.Text" Brush.FontSize="18" Text="@FavoritesText" DoNotAcceptEvents="true" />
                          </Children>
                        </ButtonWidget>
                      </Children>
                    </ListPanel>

                    <!-- Left list column (width 330) -->
                    <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="330" MarginRight="16">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhite" Color="#000000FF" AlphaFactor="0.2" IsEnabled="false" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="4" ExtendTop="4" ExtendRight="4" ExtendBottom="4" AlphaFactor="0.4" IsEnabled="false" />

                        <ScrollablePanel WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipRect="ListClip" InnerPanel="ListClip\ListInner" MarginLeft="8" MarginRight="22" MarginTop="8" MarginBottom="8" AutoHideScrollBars="true" VerticalScrollbar="..\ListScrollbar\Scrollbar">
                          <Children>
                            <Widget Id="ListClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true">
                              <Children>
                                <ListPanel Id="ListInner" DataSource="{Items}" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" LayoutImp.LayoutMethod="VerticalTopToBottom">
                                  <ItemTemplate>
                                    <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="64" MarginBottom="6" Brush="Popup.Cancel.Button" Command.Click="ExecuteSelect" IsSelected="@IsSelected" UpdateChildrenStates="true">
                                      <Children>
                                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhiteSquare_9" Color="#2A2017FF" AlphaFactor="0.75" IsEnabled="false" />
                                        <Widget WidthSizePolicy="Fixed" HeightSizePolicy="StretchToParent" SuggestedWidth="4" HorizontalAlignment="Left" MarginTop="6" MarginBottom="6" Sprite="BlankWhiteSquare_9" Color="#DDBB73FF" AlphaFactor="0.7" IsEnabled="false" />
                                        <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" VerticalAlignment="Top" MarginTop="8" MarginLeft="16" MarginRight="14" Brush="Popup.Title.Text" Brush.FontSize="17" Text="@Title" DoNotAcceptEvents="true" />
                                        <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="18" VerticalAlignment="Bottom" MarginBottom="8" MarginLeft="16" MarginRight="14" Brush="Popup.Description.Text" Brush.FontSize="13" Text="@DateText" DoNotAcceptEvents="true" />
                                      </Children>
                                    </ButtonWidget>
                                  </ItemTemplate>
                                </ListPanel>
                              </Children>
                            </Widget>
                          </Children>
                        </ScrollablePanel>
                        <Standard.VerticalScrollbar Id="ListScrollbar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" VerticalAlignment="Bottom" MarginTop="8" MarginBottom="8" MarginRight="4" />
                      </Children>
                    </Widget>

                    <!-- Right image preview and details with adaptive width -->
                    <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="8">
                      <Children>
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="BlankWhite" Color="#000000FF" AlphaFactor="0.15" IsEnabled="false" />
                        <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="4" ExtendTop="4" ExtendRight="4" ExtendBottom="4" AlphaFactor="0.4" IsEnabled="false" />

                        <!-- Empty-state hint -->
                        <RichTextWidget IsVisible="@HasNoSelection" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" HorizontalAlignment="Center" VerticalAlignment="Center" MarginLeft="20" MarginRight="20" Brush="Popup.Description.Text" Brush.FontSize="20" Brush.TextHorizontalAlignment="Center" Text="@StatusText" DoNotAcceptEvents="true" />

                        <Widget IsVisible="@HasSelection" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="16" MarginRight="16" MarginTop="14" MarginBottom="14">
                          <Children>
                            <!-- Image title -->
                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="32" VerticalAlignment="Top" Brush="Popup.Title.Text" Brush.FontSize="22" Brush.TextHorizontalAlignment="Left" Text="@SelectedTitle" DoNotAcceptEvents="true" />

                            <!-- Large-image frame -->
                            <Widget WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="520" SuggestedHeight="520" HorizontalAlignment="Left" VerticalAlignment="Top" MarginTop="40">
                              <Children>
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="frame_9" ExtendLeft="6" ExtendTop="6" ExtendRight="6" ExtendBottom="6" AlphaFactor="0.7" DoNotAcceptEvents="true" />
                                <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" Sprite="@SelectedSpriteName" ImageFit.Type="Contain" DoNotAcceptEvents="true" />
                              </Children>
                            </Widget>

                            <!-- Right-side description, without the prompt -->
                            <Widget WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginLeft="546" MarginTop="40">
                              <Children>
                                <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="24" VerticalAlignment="Top" Brush="Popup.Description.Text" Brush.FontSize="16" Text="@SelectedDate" DoNotAcceptEvents="true" />
                                <ScrollablePanel Id="GalleryThemeScroll" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" MarginTop="32" MarginRight="22" ClipRect="ThemeClip" InnerPanel="ThemeClip\ThemeInner" MouseScrollAxis="Vertical" AutoHideScrollBars="true" UpdateScrollbarVisibility="true" AutoAdjustScrollbarHandleSize="true" VerticalScrollbar="..\ThemeScrollbar\Scrollbar">
                                  <Children>
                                    <Widget Id="ThemeClip" WidthSizePolicy="StretchToParent" HeightSizePolicy="StretchToParent" ClipContents="true" DoNotAcceptEvents="true">
                                      <Children>
                                        <Widget Id="ThemeInner" WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" DoNotAcceptEvents="true">
                                          <Children>
                                            <RichTextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="CoverChildren" VerticalAlignment="Top" Brush="Popup.Description.Text" Brush.FontSize="15" Text="@SelectedTheme" CanBreakWords="true" DoNotAcceptEvents="true" />
                                          </Children>
                                        </Widget>
                                      </Children>
                                    </Widget>
                                  </Children>
                                </ScrollablePanel>
                                <Standard.VerticalScrollbar Id="ThemeScrollbar" HeightSizePolicy="StretchToParent" HorizontalAlignment="Right" MarginTop="32" MarginBottom="8" MarginRight="4" />
                              </Children>
                            </Widget>
                          </Children>
                        </Widget>
                      </Children>
                    </Widget>
                  </Children>
                </ListPanel>
              </Children>
            </Widget>

            <!-- Bottom buttons -->
            <ListPanel WidthSizePolicy="CoverChildren" HeightSizePolicy="Fixed" SuggestedHeight="50" HorizontalAlignment="Center" VerticalAlignment="Bottom" MarginBottom="18" LayoutImp.LayoutMethod="HorizontalLeftToRight">
              <Children>
                <ButtonWidget IsVisible="@HasSelection" IsEnabled="@CanRedrawBasedOnImage" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="46" MarginRight="12" Brush="Popup.Done.Button" Command.Click="ExecuteRedrawBasedOnImage" UpdateChildrenStates="true">
                  <Children><TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" VerticalAlignment="Center" Brush="Popup.Button.Text" Brush.FontSize="18" Text="@RedrawBasedOnImageText" DoNotAcceptEvents="true" /></Children>
                </ButtonWidget>
                <ButtonWidget IsVisible="@HasSelection" IsEnabled="@CanConvertToRpItem" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="46" MarginRight="12" Brush="Popup.Done.Button" Command.Click="ExecuteConvertToRpItem" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" VerticalAlignment="Center" Brush="Popup.Button.Text" Brush.FontSize="18" Text="@ConvertToRpItemText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget IsVisible="@HasSelection" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="140" SuggestedHeight="46" MarginRight="12" Brush="Popup.Done.Button" Command.Click="ExecuteToggleFavorite" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" VerticalAlignment="Center" Brush="Popup.Button.Text" Brush.FontSize="18" Text="@FavoriteButtonText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget IsVisible="@HasSelection" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="150" SuggestedHeight="46" MarginRight="12" Brush="Popup.Done.Button" Command.Click="ExecuteSetDefault" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" VerticalAlignment="Center" Brush="Popup.Button.Text" Brush.FontSize="18" Text="@SetDefaultText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget IsVisible="@HasSelection" DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="120" SuggestedHeight="46" MarginRight="12" Brush="Popup.Cancel.Button" Command.Click="ExecuteDelete" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" VerticalAlignment="Center" Brush="Popup.Button.Text" Brush.FontSize="18" Text="@DeleteText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="200" SuggestedHeight="46" MarginRight="16" Brush="Popup.Done.Button" Command.Click="ExecuteOpenFolder" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" VerticalAlignment="Center" Brush="Popup.Button.Text" Brush.FontSize="18" Text="@OpenFolderText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
                <ButtonWidget DoNotPassEventsToChildren="true" WidthSizePolicy="Fixed" HeightSizePolicy="Fixed" SuggestedWidth="160" SuggestedHeight="46" Brush="Popup.Done.Button" Command.Click="ExecuteClose" UpdateChildrenStates="true">
                  <Children>
                    <TextWidget WidthSizePolicy="StretchToParent" HeightSizePolicy="Fixed" SuggestedHeight="22" VerticalAlignment="Center" Brush="Popup.Button.Text" Brush.FontSize="18" Text="@CloseText" DoNotAcceptEvents="true" />
                  </Children>
                </ButtonWidget>
              </Children>
            </ListPanel>
          </Children>
        </Widget>
      </Children>
    </Widget>
  </Window>
</Prefab>
